<%- include('parts/header', { title: 'My Recipes' }) %>

<div class="container">
    <h1>My Recipes</h1>
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <p>Welcome, <%= user.email %>!</p>
        <a href="/recipes/new" class="btn btn-primary">Add New Recipe</a>
    </div>

    <% if (recipes && recipes.length > 0) { %>
        <div class="row">
            <% recipes.forEach(recipe => { %>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><%= recipe.title %></h5>
                            <p class="card-text">
                                <small class="text-muted">
                                    Serves: <%= recipe.base_servings %> | 
                                    Prep: <%= recipe.prep_time %>min | 
                                    Cook: <%= recipe.cook_time %>min
                                </small>
                            </p>
                            <a href="/recipes/<%= recipe.id %>" class="btn btn-outline-primary">View Recipe</a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="alert alert-info">
            <h4>No recipes yet!</h4>
            <p>Start by <a href="/recipes/new">adding your first recipe</a>.</p>
        </div>
    <% } %>
</div>

<%- include('parts/footer') %>
