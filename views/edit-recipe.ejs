<%- include('parts/header', { title: 'Edit Recipe' }) %>

<div class="container">
    <h1>Edit Recipe</h1>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <form action="/recipes/<%= recipe.id %>" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
            <label for="title" class="form-label">Recipe Title *</label>
            <input type="text" class="form-control" id="title" name="title" value="<%= recipe.title %>" required>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label for="servings" class="form-label">Servings *</label>
                <input type="number" class="form-control" id="servings" name="servings" value="<%= recipe.base_servings %>" min="1" required>
            </div>
            <div class="col-md-4 mb-3">
                <label for="prep_time" class="form-label">Prep Time (minutes)</label>
                <input type="number" class="form-control" id="prep_time" name="prep_time" value="<%= recipe.prep_time || 0 %>" min="0">
            </div>
            <div class="col-md-4 mb-3">
                <label for="cook_time" class="form-label">Cook Time (minutes)</label>
                <input type="number" class="form-control" id="cook_time" name="cook_time" value="<%= recipe.cook_time || 0 %>" min="0">
            </div>
        </div>

        <div class="mb-4">
            <h4>Ingredients</h4>
            <div id="ingredients-container">
                <% if (recipe.ingredients && recipe.ingredients.length > 0) { %>
                    <% recipe.ingredients.forEach((ingredient, index) => { %>
                        <div class="ingredient-row mb-2">
                            <div class="d-flex gap-2 align-items-center">
                                <input type="number" step="0.01" class="form-control form-control-sm" name="ingredients[<%= index %>][amount]" 
                                       placeholder="Amount" value="<%= ingredient.amount %>" required style="width: 80px;">
                                <select class="form-select form-select-sm" name="ingredients[<%= index %>][unit]" style="width: 80px;">
                                    <option value="">Unit</option>
                                    <option value="cup" <%= (ingredient.unit && ingredient.unit.name === 'cup') ? 'selected' : '' %>>cup</option>
                                    <option value="tablespoon" <%= (ingredient.unit && ingredient.unit.name === 'tablespoon') ? 'selected' : '' %>>tbsp</option>
                                    <option value="teaspoon" <%= (ingredient.unit && ingredient.unit.name === 'teaspoon') ? 'selected' : '' %>>tsp</option>
                                    <option value="ounce" <%= (ingredient.unit && ingredient.unit.name === 'ounce') ? 'selected' : '' %>>oz</option>
                                    <option value="pound" <%= (ingredient.unit && ingredient.unit.name === 'pound') ? 'selected' : '' %>>lb</option>
                                    <option value="gram" <%= (ingredient.unit && ingredient.unit.name === 'gram') ? 'selected' : '' %>>g</option>
                                    <option value="kilogram" <%= (ingredient.unit && ingredient.unit.name === 'kilogram') ? 'selected' : '' %>>kg</option>
                                    <option value="milliliter" <%= (ingredient.unit && ingredient.unit.name === 'milliliter') ? 'selected' : '' %>>ml</option>
                                    <option value="liter" <%= (ingredient.unit && ingredient.unit.name === 'liter') ? 'selected' : '' %>>l</option>
                                    <option value="piece" <%= (ingredient.unit && ingredient.unit.name === 'piece') ? 'selected' : '' %>>pcs</option>
                                    <option value="clove" <%= (ingredient.unit && ingredient.unit.name === 'clove') ? 'selected' : '' %>>clove</option>
                                    <option value="pinch" <%= (ingredient.unit && ingredient.unit.name === 'pinch') ? 'selected' : '' %>>pinch</option>
                                </select>
                                <div class="position-relative" style="flex: 2;">
                                    <input type="text" class="form-control form-control-sm ingredient-input" name="ingredients[<%= index %>][name]" 
                                           placeholder="Ingredient name" value="<%= ingredient.name %>" required autocomplete="off">
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm remove-ingredient" style="width: 35px;">×</button>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="ingredient-row mb-2">
                        <div class="d-flex gap-2 align-items-center">
                            <input type="number" step="0.01" class="form-control form-control-sm" name="ingredients[0][amount]" 
                                   placeholder="Amount" required style="width: 80px;">
                            <select class="form-select form-select-sm" name="ingredients[0][unit]" style="width: 80px;">
                                <option value="">Unit</option>
                                <option value="cup">cup</option>
                                <option value="tablespoon">tbsp</option>
                                <option value="teaspoon">tsp</option>
                                <option value="ounce">oz</option>
                                <option value="pound">lb</option>
                                <option value="gram">g</option>
                                <option value="kilogram">kg</option>
                                <option value="milliliter">ml</option>
                                <option value="liter">l</option>
                                <option value="piece">pcs</option>
                                <option value="clove">clove</option>
                                <option value="pinch">pinch</option>
                            </select>
                            <div class="position-relative" style="flex: 2;">
                                <input type="text" class="form-control form-control-sm ingredient-input" name="ingredients[0][name]" 
                                       placeholder="Ingredient name" required autocomplete="off">
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm remove-ingredient" style="width: 35px;">×</button>
                        </div>
                    </div>
                <% } %>
            </div>
            <button type="button" id="add-ingredient" class="btn btn-outline-primary btn-sm mt-2">+ Add Ingredient</button>
        </div>

        <div class="mb-3">
            <label for="instructions" class="form-label">Instructions *</label>
            <textarea class="form-control" id="instructions" name="instructions" rows="6" required><%= recipe.instructions || '' %></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Update Recipe</button>
            <a href="/recipes/<%= recipe.id %>" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script>
let ingredientCount = <%= recipe.ingredients ? recipe.ingredients.length : 1 %>;

document.getElementById('add-ingredient').addEventListener('click', function() {
    const container = document.getElementById('ingredients-container');
    const newRow = document.createElement('div');
    newRow.className = 'ingredient-row mb-2';
    newRow.innerHTML = `
        <div class="d-flex gap-2 align-items-center">
            <input type="number" step="0.01" class="form-control form-control-sm" name="ingredients[${ingredientCount}][amount]" 
                   placeholder="Amount" required style="width: 80px;">
            <select class="form-select form-select-sm" name="ingredients[${ingredientCount}][unit]" style="width: 80px;">
                <option value="">Unit</option>
                <option value="cup">cup</option>
                <option value="tablespoon">tbsp</option>
                <option value="teaspoon">tsp</option>
                <option value="ounce">oz</option>
                <option value="pound">lb</option>
                <option value="gram">g</option>
                <option value="kilogram">kg</option>
                <option value="milliliter">ml</option>
                <option value="liter">l</option>
                <option value="piece">pcs</option>
                <option value="clove">clove</option>
                <option value="pinch">pinch</option>
            </select>
            <div class="position-relative" style="flex: 2;">
                <input type="text" class="form-control form-control-sm ingredient-input" name="ingredients[${ingredientCount}][name]" 
                       placeholder="Ingredient name" required autocomplete="off">
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm remove-ingredient" style="width: 35px;">×</button>
        </div>
    `;
    container.appendChild(newRow);
    ingredientCount++;
    updateAutocomp();
});

document.addEventListener('click', function(e) {
    if (e.target.classList.contains('remove-ingredient')) {
        const ingredientRows = document.querySelectorAll('.ingredient-row');
        if (ingredientRows.length > 1) {
            e.target.closest('.ingredient-row').remove();
            updateeIngredientIndexes();
        }
    }
});

function updateeIngredientIndexes() {
    const rows = document.querySelectorAll('.ingredient-row');
    rows.forEach((row, index) => {
        const inputs = row.querySelectorAll('input');
        const select = row.querySelector('select');
        inputs[0].name = `ingredients[${index}][amount]`;
        select.name = `ingredients[${index}][unit]`;
        inputs[1].name = `ingredients[${index}][name]`;
    });
    ingredientCount = rows.length;
}

let availableIngredients = [];

async function loadAutocompleteData() {
    try {
        const ingredientsResponse = await fetch('/api/ingredients');
        
        if (ingredientsResponse.ok) {
            availableIngredients = await ingredientsResponse.json();
        }
        
        updateAutocomp();
    } catch (error) {
        console.error('Error loading autocomplete data:', error);
    }
}

function updateAutocomp() {
    document.querySelectorAll('.ingredient-input').forEach(input => {
        if (!input.hasAttribute('data-autocomplete-initialized')) {
            setupAutocomplete(input, availableIngredients.map(i => i.name));
            input.setAttribute('data-autocomplete-initialized', 'true');
        }
    });
}

function setupAutocomplete(input, suggestions) {
    input.addEventListener('input', function() {
        const value = this.value.toLowerCase();
        const filtered = suggestions.filter(item => 
            item.toLowerCase().includes(value)
        ).slice(0, 5);
        
        showSuggestions(this, filtered);
    });
}

function showSuggestions(input, suggestions) {
    const existingDropdown = document.querySelector('.autocomplete-dropdown');
    if (existingDropdown) {
        existingDropdown.remove();
    }
    
    if (suggestions.length === 0 || !input.value) return;
    
    const dropdown = document.createElement('div');
    dropdown.className = 'autocomplete-dropdown position-absolute bg-white border rounded shadow-sm';
    dropdown.style.cssText = 'top: calc(100% + 2px); left: 0; width: 100%; z-index: 1000; max-height: 200px; overflow-y: auto;';
    
    suggestions.forEach(suggestion => {
        const item = document.createElement('div');
        item.className = 'px-3 py-2 cursor-pointer';
        item.style.cursor = 'pointer';
        item.textContent = suggestion;
        
        item.addEventListener('mouseenter', () => item.style.backgroundColor = '#f8f9fa');
        item.addEventListener('mouseleave', () => item.style.backgroundColor = '');
        item.addEventListener('click', () => {
            input.value = suggestion;
            dropdown.remove();
        });
        
        dropdown.appendChild(item);
    });
    
    const wrapperDiv = input.closest('.position-relative');
    wrapperDiv.appendChild(dropdown);
}

document.addEventListener('click', function(e) {
    if (!e.target.classList.contains('ingredient-input')) {
        document.querySelectorAll('.autocomplete-dropdown').forEach(dropdown => {
            dropdown.remove();
        });
    }
});

document.addEventListener('DOMContentLoaded', function() {
    loadAutocompleteData();
});
</script>

<%- include('parts/footer') %>
