<%- include('parts/header', { title: 'Error' }) %>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Oops! Something went wrong</h4>
