<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - Recipe App' : 'Recipe App' %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="/js/images/logo.png" alt="PortinPrefect Logo" class="logo">
                PortinPrefect
            </a>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/">Home</a>
                </li>
                <li class="nav-item">
                </li>
                <% if (locals.user) { %>
                    <li class="nav-item">
                         <a class="nav-link" href="/recipes">Recipes</a>

                        <a class="nav-link" href="/recipes/new">Add Recipe</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropbtn" href="#" onclick="toggleDropdown(event)">
                            <%= user.email %> ▼
                        </a>
                        <div class="dropdown-content" id="userDropdown">
                            <a href="/logout">Logout</a>
                        </div>
                    </li>
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/signup">Sign Up</a>
                    </li>
                <% } %>
            </ul>
        </div>
    </nav>

    <script>
    function toggleDropdown(event) {
        event.preventDefault();
        const dropdown = document.getElementById('userDropdown');
        dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
    }

    document.addEventListener('click', function(event) {
        const dropdown = document.getElementById('userDropdown');
        const dropbtn = event.target.closest('.dropbtn');
        if (!dropbtn && dropdown) {
            dropdown.style.display = 'none';
        }
    });
    </script>
</body>
</html>
