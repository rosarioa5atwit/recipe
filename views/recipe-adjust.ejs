<%- include('parts/header', { title: 'Recipe Ingredient Manager - ' + recipe.title }) %>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h5 class="mb-0"><%= recipe.title %></h5>
                            <small class="text-muted">Original: <%= recipe.base_servings %> servings</small>
                        </div>
                        <div class="col-md-3">
                            <a href="/recipes/<%= recipe.id %>" class="btn btn-secondary w-100">
                                ← Back to Recipe
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0">Ingredient Availability Checker</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ingredient</th>
                                    <th>Recipe Needs</th>
                                    <th>Amount I Have</th>
                                    <th>Adjusted Amount</th>
                                    <th>Substitution</th>
                                </tr>
                            </thead>
                            <tbody id="ingredients-table">
                                <% if (recipe.ingredients && recipe.ingredients.length > 0) { %>
                                    <% recipe.ingredients.forEach((ingredient, index) => { %>
                                        <tr data-ingredient="<%= index %>">
                                            <td>
                                                <div class="fw-bold ingredient-name"><%= ingredient.name %></div>
                                                <div class="substitute-info" style="display: none;">
                                                    <small class="text-warning">Using substitute</small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="needed-amount fw-bold text-primary" data-original="<%= ingredient.amount %>">
                                                    <%= ingredient.amount %>
                                                </span>
                                                <% if (ingredient.unit && ingredient.unit.name) { %>
                                                    <small class="text-muted"><%= ingredient.unit.name %></small>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-1">
                                                    <input type="number" step="0.01" class="form-control form-control-sm have-amount" 
                                                        value="<%= ingredient.amount %>" style="width: 80px;">
                                                    <select class="form-select form-select-sm have-unit" style="width: 70px;">
                                                        <% if (ingredient.unit && ingredient.unit.name) { %>
                                                            <option value="<%= ingredient.unit.name %>" selected><%= ingredient.unit.name %></option>
                                                        <% } else { %>
                                                            <option value="" selected>-</option>
                                                        <% } %>
                                                        <option value="cups">cups</option>
                                                        <option value="tbsp">tbsp</option>
                                                        <option value="tsp">tsp</option>
                                                        <option value="oz">oz</option>
                                                        <option value="lb">lb</option>
                                                        <option value="g">g</option>
                                                        <option value="kg">kg</option>
                                                        <option value="ml">ml</option>
                                                        <option value="l">l</option>
                                                        <option value="pcs">pcs</option>
                                                        <option value="cloves">cloves</option>
                                                        <option value="slices">slices</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="adjusted-amount-display badge bg-info" id="adjusted-amount-<%= index %>">
                                                    Enter amounts above
                                                </span>
                                            </td>
                                            <td>
                                                <% if (ingredient.substitutions && ingredient.substitutions.length > 0) { %>
                                                    <div class="custom-dropdown position-relative">
                                                        <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" 
                                                                data-dropdown-toggle="dropdownSubstitute<%= index %>">
                                                            <i class="fas fa-exchange-alt me-1"></i>Substitute
                                                        </button>
                                                        <div class="dropdown-menu custom-dropdown-menu" 
                                                             id="dropdownSubstitute<%= index %>" 
                                                             style="min-width: 250px; display: none;">
                                                            <h6 class="dropdown-header text-primary">
                                                                <i class="fas fa-star me-1"></i>Available Substitutes
                                                            </h6>
                                                            <hr class="dropdown-divider">
                                                            <% ingredient.substitutions.forEach((sub, subIdx) => { %>
                                                                <a class="dropdown-item substitute-option d-flex justify-content-between align-items-center" 
                                                                   href="#" 
                                                                   data-ingredient-index="<%= index %>" 
                                                                   data-substitute="<%= sub.name %>" 
                                                                   data-ratio="<%= sub.ratio || 1 %>"
                                                                   data-units="<%= sub.units || '' %>">
                                                                    <span>
                                                                        <i class="fas fa-arrow-right me-2 text-muted"></i>
                                                                        <%= sub.name %>
                                                                        <% if (sub.units && sub.units !== (ingredient.unit?.name || '')) { %>
                                                                            <small class="text-info"> (in <%= sub.units %>)</small>
                                                                        <% } %>
                                                                    </span>
                                                                    <small class="text-muted">
                                                                        <%= (sub.ratio || 1) %>:1
                                                                    </small>
                                                                </a>
                                                            <% }); %>
                                                            <hr class="dropdown-divider">
                                                            <a class="dropdown-item remove-substitute text-danger" href="#" 
                                                               data-ingredient-index="<%= index %>">
                                                                <i class="fas fa-times me-2"></i>Clear Substitute
                                                            </a>
                                                        </div>
                                                    </div>
                                                <% } else { %>
                                                    <span class="text-muted small">
                                                        <i class="fas fa-minus-circle me-1"></i>None available
                                                    </span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">
                                            No ingredients found for this recipe
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">Adjusted Recipe</h6>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th class="fw-bold">Ingredient</th>
                                <th class="text-end">Adjusted Amount</th>
                            </tr>
                        </thead>
                        <tbody id="adjusted-recipe-table">
                            <% if (recipe.ingredients && recipe.ingredients.length > 0) { %>
                                <% recipe.ingredients.forEach((ingredient, index) => { %>
                                    <tr>
                                        <td><%= ingredient.name %></td>
                                        <td class="text-end">
                                            <span id="adjusted-amount-summary-<%= index %>"><%= ingredient.amount %></span>
                                            <% if (ingredient.unit && ingredient.unit.name) { %>
                                                <small class="text-muted"><%= ingredient.unit.name %></small>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="2" class="text-muted text-center">No ingredients found</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                    
                    <!-- Add Directions Section -->
                    <% if (recipe.instructions && recipe.instructions.trim().length > 0) { %>
                        <div class="mt-4">
                            <h6 class="fw-bold text-primary mb-3">
                                <i class="fas fa-list-ol me-2"></i>Directions
                            </h6>
                            <div class="directions-content">
                                <div class="p-3 bg-light rounded">
                                    <p class="mb-0" style="white-space: pre-line;"><%= recipe.instructions %></p>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="mt-4">
                            <h6 class="fw-bold text-primary mb-3">
                                <i class="fas fa-list-ol me-2"></i>Directions
                            </h6>
                            <p class="text-muted">No directions available for this recipe.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.custom-dropdown {
    position: relative;
}

.custom-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 1000;
    background-color: #fff;
    border: 1px solid rgba(0,0,0,.15);
    border-radius: 0.375rem;
    box-shadow: 0 0.5rem 1rem rgba(0,0,0,.175);
    padding: 0.5rem 0;
    margin: 0.125rem 0 0;
    min-width: 250px;
}

/* Ensure dropdown appears above table overflow */
.table-responsive {
    overflow: visible;
}

/* Alternative positioning for dropdowns that might go off-screen */
.custom-dropdown-menu.dropdown-menu-end {
    left: auto;
    right: 0;
}

.custom-dropdown-menu .dropdown-item {
    display: block;
    width: 100%;
    padding: 0.375rem 1rem;
    clear: both;
    font-weight: 400;
    color: #212529;
    text-decoration: none;
    white-space: nowrap;
    background-color: transparent;
    border: 0;
}

.custom-dropdown-menu .dropdown-item:hover,
.custom-dropdown-menu .dropdown-item:focus {
    color: #1e2125;
    background-color: #e9ecef;
}

.custom-dropdown-menu .dropdown-header {
    display: block;
    padding: 0.5rem 1rem;
    margin-bottom: 0;
    font-size: 0.875rem;
    color: #6c757d;
    white-space: nowrap;
}

.custom-dropdown-menu .dropdown-divider {
    height: 0;
    margin: 0.5rem 0;
    overflow: hidden;
    border-top: 1px solid rgba(0,0,0,.15);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize variables
    let originalServings = <%- JSON.stringify(recipe.base_servings || 1) %>;
    let activeSubstitutions = {};

    // Check if recipe data is properly loaded
    const recipeData = <%- JSON.stringify(recipe) %>;
    console.log('Recipe data loaded:', recipeData);

    // Initialize custom dropdowns
    console.log('Initializing custom dropdowns...');
    initializeCustomDropdowns();

    // Add debugging for substitutions
    console.log('Checking ingredient substitutions:');
    recipeData.ingredients?.forEach((ingredient, index) => {
        console.log(`Ingredient ${index} (${ingredient.name}):`, {
            hasSubstitutions: !!(ingredient.substitutions && ingredient.substitutions.length > 0),
            substitutionsCount: ingredient.substitutions?.length || 0,
            substitutions: ingredient.substitutions || 'undefined'
        });
    });

    // Setup event listeners
    document.querySelectorAll('.have-amount').forEach(input => {
        input.addEventListener('input', handleIngredientChange);
    });

    document.querySelectorAll('.have-unit').forEach(select => {
        select.addEventListener('change', handleIngredientChange);
    });

    document.querySelectorAll('.substitute-option').forEach(option => {
        option.addEventListener('click', applySubstitution);
    });

    document.querySelectorAll('.remove-substitute').forEach(button => {
        button.addEventListener('click', removeSubstitution);
    });

    // Initial updates
    updateAllStatuses();
    updateAdjustedAmounts(1.0, false);

    // Main functions
    async function handleIngredientChange(event) {
        const row = event.target.closest('[data-ingredient]');
        const index = row ? parseInt(row.getAttribute('data-ingredient')) : -1;
        
        if (index >= 0) {
            await updateIngredientStatus(index);
            await checkForAutoAdjustment();
        }
    }

    async function updateIngredientStatus(index) {
        console.log(`🔍 Updating ingredient ${index} status...`);
        const row = document.querySelector(`[data-ingredient="${index}"]`);
        if (!row) return;
        
        const neededAmountEl = row.querySelector('.needed-amount');
        const neededAmount = parseFloat(neededAmountEl.textContent) || 0;
        const haveInput = row.querySelector('.have-amount');
        const haveUnitSelect = row.querySelector('.have-unit');
        
        const haveAmount = parseFloat(haveInput.value) || 0;
        const haveUnit = haveUnitSelect ? haveUnitSelect.value : '';
        
        // Safely get the needed unit
        const neededUnitEl = neededAmountEl.nextElementSibling;
        const neededUnit = neededUnitEl ? neededUnitEl.textContent.trim() : '';
        
        console.log(`📊 Ingredient ${index}: Need ${neededAmount} ${neededUnit}, Have ${haveAmount} ${haveUnit}`);
        
        let convertedHaveAmount = haveAmount;
        if (haveUnit !== neededUnit && haveUnit && neededUnit) {
            console.log(`🔄 Units differ - converting ${haveAmount} ${haveUnit} to ${neededUnit}`);
            try {
                convertedHaveAmount = await convertUnits(haveAmount, haveUnit, neededUnit);
                console.log(`📈 Converted amount: ${convertedHaveAmount} ${neededUnit}`);
            } catch (error) {
                console.error('Conversion failed:', error);
                convertedHaveAmount = haveAmount; // Fallback to original amount
            }
        } else {
            console.log(`✅ Units match or empty - no conversion needed`);
        }
        
        // Update visual state
        row.classList.remove('partial', 'insufficient');
        if (convertedHaveAmount >= neededAmount) {
            console.log(`✅ Sufficient: ${convertedHaveAmount} >= ${neededAmount}`);
            haveInput.style.borderColor = '#198754';
        } else if (convertedHaveAmount > 0) {
            console.log(`⚠️ Partial: ${convertedHaveAmount} < ${neededAmount}`);
            row.classList.add('partial');
            haveInput.style.borderColor = '#ffc107';
        } else {
            console.log(`❌ Insufficient: ${convertedHaveAmount} = 0`);
            row.classList.add('insufficient');
            haveInput.style.borderColor = '#dc3545';
        }
    }

    async function checkForAutoAdjustment() {
        const ingredients = document.querySelectorAll('[data-ingredient]');
        let limitingRatio = 1.0;
        let hasUserInputs = false;
        
        for (const row of ingredients) {
            const haveInput = row.querySelector('.have-amount');
            const haveUnitSelect = row.querySelector('.have-unit');
            const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
            
            if (haveInput.value && haveInput.value.trim() !== '') {
                hasUserInputs = true;
                const haveAmount = parseFloat(haveInput.value) || 0;
                const haveUnit = haveUnitSelect ? haveUnitSelect.value : '';
                const neededUnit = row.querySelector('.needed-amount').nextElementSibling?.textContent || '';
                
                let convertedHaveAmount = haveAmount;
                if (haveUnit !== neededUnit.trim() && haveUnit && neededUnit.trim()) {
                    convertedHaveAmount = await convertUnits(haveAmount, haveUnit, neededUnit.trim());
                }
                
                const ratio = convertedHaveAmount / neededAmount;
                if (ratio < limitingRatio) {
                    limitingRatio = ratio;
                }
            }
        }
        
        await updateAdjustedAmounts(limitingRatio, hasUserInputs);
    }

    async function convertUnits(amount, fromUnit, toUnit) {
        console.log(`🔄 CONVERTING: ${amount} ${fromUnit} → ${toUnit}`);
        
        if (fromUnit === toUnit) {
            console.log(`✅ Same units, no conversion needed: ${amount}`);
            return amount;
        }
        
        // First try API conversion
        try {
            const url = `/api/convert?amount=${amount}&from=${fromUnit}&to=${toUnit}`;
            console.log(`📡 Making API call to: ${url}`);
            
            const response = await fetch(url);
            console.log(`📥 Response status: ${response.status} ${response.statusText}`);
            
            if (response.ok) {
                const data = await response.json();
                console.log(`📥 API response data:`, data);
                
                if (data && typeof data.result === 'number') {
                    console.log(`✅ CONVERSION RESULT: ${amount} ${fromUnit} = ${data.result} ${toUnit}`);
                    return data.result;
                }
            }
        } catch (error) {
            console.error('❌ API conversion failed:', error);
        }
        
        // Fallback to client-side conversion
        console.log(`⚠️ Using fallback conversion...`);
        return convertUnitsClientSide(amount, fromUnit, toUnit);
    }

    function convertUnitsClientSide(amount, fromUnit, toUnit) {
        // Normalize units
        const normalizeUnit = (unit) => {
            const unitMap = {
                'cup': 'cups',
                'cups': 'cups',
                'tbsp': 'tbsp',
                'tsp': 'tsp',
                'pc': 'pcs',
                'pcs': 'pcs',
                'piece': 'pcs',
                'item': 'pcs',
                'clove': 'cloves',
                'cloves': 'cloves',
                'slice': 'slices',
                'slices': 'slices'
            };
            return unitMap[unit.toLowerCase()] || unit.toLowerCase();
        };
        
        const normalizedFrom = normalizeUnit(fromUnit);
        const normalizedTo = normalizeUnit(toUnit);
        
        if (normalizedFrom === normalizedTo) {
            return amount;
        }
        
        // Conversion tables (all conversions to base units)
        const conversions = {
            // Volume conversions (to ml)
            volume: {
                'ml': 1,
                'l': 1000,
                'cups': 236.588,
                'tbsp': 14.7868,
                'tsp': 4.92892,
                'fl oz': 29.5735,
                'oz': 29.5735, // fluid oz
                'qt': 946.353,
                'pt': 473.176,
                'gal': 3785.41
            },
            // Weight conversions (to grams)
            weight: {
                'g': 1,
                'kg': 1000,
                'oz': 28.3495, // weight oz
                'lb': 453.592,
                'mg': 0.001
            },
            // Count conversions (no conversion needed)
            count: {
                'pcs': 1,
                'pieces': 1,
                'items': 1,
                'cloves': 1,
                'slices': 1,
                'whole': 1,
                'each': 1
            }
        };
        
        // Find categories
        let fromCategory = null;
        let toCategory = null;
        
        for (const [category, units] of Object.entries(conversions)) {
            if (units[normalizedFrom] !== undefined) fromCategory = category;
            if (units[normalizedTo] !== undefined) toCategory = category;
        }
        
        // Check if conversion is possible
        if (fromCategory !== toCategory) {
            console.warn(`❌ Cannot convert ${fromUnit} to ${toUnit} - different unit types`);
            return amount; // Return original amount if conversion not possible
        }
        
        if (!fromCategory) {
            console.warn(`❌ Unknown units: ${fromUnit} or ${toUnit}`);
            return amount;
        }
        
        // Convert
        const fromRatio = conversions[fromCategory][normalizedFrom];
        const toRatio = conversions[fromCategory][normalizedTo];
        
        if (!fromRatio || !toRatio) {
            console.warn(`❌ Missing conversion ratios for ${fromUnit} or ${toUnit}`);
            return amount;
        }
        
        const result = (amount * fromRatio) / toRatio;
        const rounded = Math.round(result * 100000) / 100000;
        
        console.log(`🧮 Client conversion: ${amount} * ${fromRatio} / ${toRatio} = ${rounded}`);
        
        return rounded;
    }

    function formatAmount(amount) {
        if (typeof amount !== 'number' || isNaN(amount)) {
            return '0';
        }
        
        if (amount === Math.floor(amount)) return amount.toString();
        if (Math.abs(amount - 0.5) < 0.01) return '½';
        if (Math.abs(amount - 0.25) < 0.01) return '¼';
        if (Math.abs(amount - 0.75) < 0.01) return '¾';
        if (Math.abs(amount - 1.5) < 0.01) return '1½';
        if (Math.abs(amount - 2.5) < 0.01) return '2½';
        if (Math.abs(amount - 0.33) < 0.01) return '⅓';
        if (Math.abs(amount - 0.67) < 0.01) return '⅔';
        if (Math.abs(amount - 1.33) < 0.01) return '1⅓';
        if (Math.abs(amount - 1.67) < 0.01) return '1⅔';
        
        // For very small amounts, show more precision
        if (amount < 0.1) {
            return amount.toFixed(3).replace(/\.?0+$/, '');
        }
        
        return amount.toFixed(2).replace(/\.?0+$/, '');
    }

    function findBestDisplayUnit(amount, originalUnit, unitCategory) {
        console.log(`🔍 Finding best unit for ${amount} ${originalUnit} in category ${unitCategory}`);
        
        // First, normalize the original unit
        const normalizeUnit = (unit) => {
            const unitMap = {
                'cup': 'cups',
                'cups': 'cups',
                'tbsp': 'tbsp',
                'tsp': 'tsp',
                'pc': 'pcs',
                'pcs': 'pcs',
                'piece': 'pcs',
                'item': 'pcs',
                'clove': 'cloves',
                'cloves': 'cloves',
                'slice': 'slices',
                'slices': 'slices'
            };
            return unitMap[unit.toLowerCase()] || unit.toLowerCase();
        };

        const normalizedOriginal = normalizeUnit(originalUnit);
        
        // For same unit conversions or simple amounts, just return the original
        if (amount >= 0.25 && amount <= 100) {
            // Check if the amount is already reasonable in the original unit
            const isWholeNumber = Math.abs(amount - Math.round(amount)) < 0.001;
            const isCommonFraction = [0.125, 0.25, 0.33, 0.5, 0.67, 0.75].some(frac => 
                Math.abs(amount - frac) < 0.02
            );
            
            if (isWholeNumber || isCommonFraction) {
                console.log(`✅ Keeping original unit: ${formatAmount(amount)} ${normalizedOriginal}`);
                return { amount, unit: normalizedOriginal };
            }
        }

        // Get the unit category conversion table
        const conversions = {
            volume: {
                'ml': 1,
                'l': 1000,
                'cups': 236.588,
                'tbsp': 14.7868,
                'tsp': 4.92892,
                'fl oz': 29.5735,
                'oz': 29.5735,
                'qt': 946.353,
                'pt': 473.176,
                'gal': 3785.41
            },
            weight: {
                'g': 1,
                'kg': 1000,
                'oz': 28.3495,
                'lb': 453.592,
                'mg': 0.001
            },
            count: {
                'pcs': 1,
                'pieces': 1,
                'items': 1,
                'cloves': 1,
                'slices': 1,
                'whole': 1,
                'each': 1
            }
        };

        const categoryTable = conversions[unitCategory];
        if (!categoryTable || !categoryTable[normalizedOriginal]) {
            console.log(`❌ Unit '${originalUnit}' not found in ${unitCategory} category, keeping original`);
            return { amount, unit: normalizedOriginal };
        }

        // Convert amount to base unit
        const baseAmount = amount * categoryTable[normalizedOriginal];
        
        let bestUnit = normalizedOriginal;
        let bestAmount = amount;
        let bestScore = Math.abs(amount - Math.round(amount)) + 0.1; // Small penalty for original

        console.log(`  Base amount: ${baseAmount}`);

        // Test each unit in the category
        Object.keys(categoryTable).forEach(unit => {
            const convertedAmount = baseAmount / categoryTable[unit];
            
            // Skip if too small (less than 0.05) or too large (more than 1000)
            if (convertedAmount < 0.05 || convertedAmount > 1000) {
                return;
            }
            
            // Calculate score: prefer whole numbers or simple fractions
            let score = Math.abs(convertedAmount - Math.round(convertedAmount));
            
            // Check for common fractions
            const fractions = [0.125, 0.25, 0.33, 0.5, 0.67, 0.75];
            const decimal = convertedAmount - Math.floor(convertedAmount);
            
            let isFraction = false;
            fractions.forEach(frac => {
                if (Math.abs(decimal - frac) < 0.02) {
                    score = Math.min(score, 0.05);
                    isFraction = true;
                }
            });
            
            // Special bonus for exact whole numbers
            if (Math.abs(convertedAmount - Math.round(convertedAmount)) < 0.001) {
                score = 0.01;
            }
            
            // Prefer units that result in amounts between 0.25 and 50
            if (convertedAmount >= 0.25 && convertedAmount <= 50) {
                score *= 0.7;
            } else if (convertedAmount >= 0.1 && convertedAmount <= 100) {
                score *= 0.9;
            }
            
            // If this is significantly better than current best
            if (score < bestScore - 0.05) { // Require significant improvement
                bestScore = score;
                bestAmount = convertedAmount;
                bestUnit = unit;
                console.log(`    🎯 New best: ${formatAmount(convertedAmount)} ${unit}`);
            }
        });

        console.log(`🎯 Final: ${formatAmount(bestAmount)} ${bestUnit}`);
        return { amount: bestAmount, unit: bestUnit };
    }

    async function updateAdjustedAmounts(limitingRatio, hasUserInputs) {
        console.log(`🔧 Updating adjusted amounts - ratio: ${limitingRatio}, hasInputs: ${hasUserInputs}`);
        const ingredients = document.querySelectorAll('[data-ingredient]');
        
        for (let index = 0; index < ingredients.length; index++) {
            const row = ingredients[index];
            const adjustedAmountDisplay = document.getElementById(`adjusted-amount-${index}`);
            const haveInput = row.querySelector('.have-amount');
            const haveUnitSelect = row.querySelector('.have-unit');
            const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
            
            // Get current unit (could be substitute unit)
            const currentUnit = row.querySelector('.needed-amount').nextElementSibling?.textContent?.trim() || '';
            
            console.log(`  Ingredient ${index}: needed=${neededAmount} ${currentUnit}`);
            
            if (!hasUserInputs) {
                // Convert full recipe amount to best display unit
                const unitCategory = getUnitCategory(currentUnit);
                const bestDisplay = findBestDisplayUnit(neededAmount, currentUnit, unitCategory);
                adjustedAmountDisplay.className = 'adjusted-amount-display badge bg-success';
                adjustedAmountDisplay.textContent = `Use ${formatAmount(bestDisplay.amount)} ${bestDisplay.unit}`;
                continue;
            }
            
            if (!haveInput.value || haveInput.value.trim() === '') {
                adjustedAmountDisplay.className = 'adjusted-amount-display badge bg-secondary';
                adjustedAmountDisplay.textContent = 'Enter amount above';
                continue;
            }
            
            const haveAmount = parseFloat(haveInput.value) || 0;
            const haveUnit = haveUnitSelect ? haveUnitSelect.value : '';
            
            let convertedHaveAmount = haveAmount;
            
            if (haveUnit !== currentUnit && haveUnit && currentUnit) {
                convertedHaveAmount = await convertUnits(haveAmount, haveUnit, currentUnit);
            }
            
            // Calculate the actual amount to use
            let amountToUse;
            if (limitingRatio >= 1.0 && convertedHaveAmount >= neededAmount) {
                amountToUse = neededAmount;
                adjustedAmountDisplay.className = 'adjusted-amount-display badge bg-success';
            } else if (limitingRatio > 0) {
                amountToUse = neededAmount * limitingRatio;
                adjustedAmountDisplay.className = 'adjusted-amount-display badge bg-warning';
            } else {
                adjustedAmountDisplay.className = 'adjusted-amount-display badge bg-danger';
                adjustedAmountDisplay.textContent = 'Cannot use';
                continue;
            }
            
            // Convert to best display unit
            const unitCategory = getUnitCategory(currentUnit);
            const bestDisplay = findBestDisplayUnit(amountToUse, currentUnit, unitCategory);
            adjustedAmountDisplay.textContent = `Use ${formatAmount(bestDisplay.amount)} ${bestDisplay.unit}`;
        }
        
        updateAdjustedRecipeTable();
    }

    function updateAdjustedRecipeTable() {
        // Remove servings and scale factor updates since they're no longer displayed
        document.querySelectorAll('[data-ingredient]').forEach((row, index) => {
            const adjustedAmountDisplay = document.getElementById(`adjusted-amount-${index}`);
            const summaryEl = document.getElementById(`adjusted-amount-summary-${index}`);
            
            // Update ingredient name to show substitute if applicable
            const ingredientNameCell = document.querySelector(`#adjusted-recipe-table tr:nth-child(${index + 1}) td:first-child`);
            if (ingredientNameCell) {
                const originalName = row.querySelector('.ingredient-name').textContent;
                
                if (activeSubstitutions[index]) {
                    // Show substitute name with units if different
                    let displayText = `<span class="text-warning fw-bold">${activeSubstitutions[index].name}</span>`;
                    if (activeSubstitutions[index].units) {
                        const unitDisplay = row.querySelector('.needed-amount').nextElementSibling;
                        const originalUnit = unitDisplay?.getAttribute('data-original-unit') || '';
                        if (activeSubstitutions[index].units !== originalUnit) {
                            displayText += ` <small class="text-muted">(${activeSubstitutions[index].units})</small>`;
                        }
                    }
                    ingredientNameCell.innerHTML = displayText;
                } else {
                    // Show original name
                    ingredientNameCell.textContent = originalName;
                }
            }
            
            if (summaryEl && adjustedAmountDisplay) {
                const adjustedText = adjustedAmountDisplay.textContent;
                
                if (adjustedText.includes('Use ')) {
                    const match = adjustedText.match(/Use\s+([^\s]+)\s+(.+)/);
                    if (match) {
                        summaryEl.textContent = match[1];
                        const unitEl = summaryEl.nextElementSibling;
                        if (unitEl) {
                            unitEl.textContent = match[2];
                        }
                    }
                } else if (adjustedText === 'Can make full recipe') {
                    // Convert to best display unit for full recipe
                    const neededAmountEl = row.querySelector('.needed-amount');
                    const originalAmount = parseFloat(neededAmountEl.textContent);
                    const currentUnit = neededAmountEl.nextElementSibling?.textContent?.trim() || '';
                    
                    const unitCategory = getUnitCategory(currentUnit);
                    const bestDisplay = findBestDisplayUnit(originalAmount, currentUnit, unitCategory);
                    
                    summaryEl.textContent = formatAmount(bestDisplay.amount);
                    const unitEl = summaryEl.nextElementSibling;
                    if (unitEl) {
                        unitEl.textContent = bestDisplay.unit;
                    }
                } else if (adjustedText === 'Cannot use') {
                    summaryEl.textContent = '0';
                    const unitEl = summaryEl.nextElementSibling;
                    if (unitEl) {
                        // Get current unit for consistency
                        const currentUnit = row.querySelector('.needed-amount').nextElementSibling?.textContent?.trim() || '';
                        unitEl.textContent = currentUnit;
                    }
                } else {
                    // Fallback to original display
                    const neededAmountEl = row.querySelector('.needed-amount');
                    const originalAmount = parseFloat(neededAmountEl.textContent);
                    const currentUnit = neededAmountEl.nextElementSibling?.textContent?.trim() || '';
                    
                    const unitCategory = getUnitCategory(currentUnit);
                    const bestDisplay = findBestDisplayUnit(originalAmount, currentUnit, unitCategory);
                    
                    summaryEl.textContent = formatAmount(bestDisplay.amount);
                    const unitEl = summaryEl.nextElementSibling;
                    if (unitEl) {
                        unitEl.textContent = bestDisplay.unit;
                    }
                }
            }
        });
    }

    function initializeCustomDropdowns() {
        // Handle dropdown toggle clicks
        document.querySelectorAll('[data-dropdown-toggle]').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const targetId = this.getAttribute('data-dropdown-toggle');
                const dropdown = document.getElementById(targetId);
                
                // Close all other dropdowns
                document.querySelectorAll('.custom-dropdown-menu').forEach(menu => {
                    if (menu.id !== targetId) {
                        menu.style.display = 'none';
                    }
                });
                
                // Position dropdown relative to button
                if (dropdown.style.display === 'none' || dropdown.style.display === '') {
                    // Show dropdown
                    dropdown.style.display = 'block';
                    
                    // Check if dropdown goes off-screen and adjust position
                    const rect = dropdown.getBoundingClientRect();
                    const viewportWidth = window.innerWidth;
                    
                    // If dropdown goes off the right edge, align it to the right of the button
                    if (rect.right > viewportWidth) {
                        dropdown.classList.add('dropdown-menu-end');
                    } else {
                        dropdown.classList.remove('dropdown-menu-end');
                    }
                } else {
                    dropdown.style.display = 'none';
                }
            });
        });
        
        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.custom-dropdown')) {
                document.querySelectorAll('.custom-dropdown-menu').forEach(menu => {
                    menu.style.display = 'none';
                });
            }
        });
        
        console.log('Custom dropdowns initialized');
    }

    function getUnitCategory(unit) {
        const volumeUnits = ['ml', 'l', 'cups', 'tbsp', 'tsp', 'fl oz', 'oz', 'qt', 'pt', 'gal'];
        const weightUnits = ['g', 'kg', 'oz', 'lb', 'mg'];
        const countUnits = ['pcs', 'pieces', 'items', 'cloves', 'slices', 'whole', 'each'];

        const normalizedUnit = unit.toLowerCase();
        
        if (volumeUnits.includes(normalizedUnit)) return 'volume';
        if (weightUnits.includes(normalizedUnit)) return 'weight';
        if (countUnits.includes(normalizedUnit)) return 'count';
        
        return 'volume'; // Default fallback
    }

    function updateScale() {
        // Since we removed target servings, always use original servings (scale factor = 1.0)
        const targetServings = originalServings;
        const scaleFactor = 1.0;
        
        document.querySelectorAll('.needed-amount').forEach(element => {
            const originalAmount = parseFloat(element.dataset.original);
            const substituteRatio = parseFloat(element.dataset.substituteRatio) || 1;
            const scaledAmount = originalAmount * scaleFactor * substituteRatio;
            element.textContent = formatAmount(scaledAmount);
        });
        
        updateAllStatuses();
        updateAdjustedRecipeTable();
    }

    async function updateAllStatuses() {
        const ingredients = document.querySelectorAll('[data-ingredient]');
        for (let index = 0; index < ingredients.length; index++) {
            await updateIngredientStatus(index);
        }
    }

    function applySubstitution(event) {
        event.preventDefault();
        const index = parseInt(event.target.getAttribute('data-ingredient-index'));
        const substitute = event.target.getAttribute('data-substitute');
        const ratio = parseFloat(event.target.getAttribute('data-ratio')) || 1;
        const substituteUnits = event.target.getAttribute('data-units') || '';
        
        console.log(`🔄 Applying substitution for ingredient ${index}: ${substitute} (ratio: ${ratio}, units: "${substituteUnits}")`);
        
        // Check for valid index
        if (isNaN(index) || index < 0) {
            console.error('Invalid ingredient index:', index);
            return;
        }
        
        // Update the row with substitution info
        const row = document.querySelector(`[data-ingredient="${index}"]`);
        if (row) {
            row.classList.add('substituted');
            
            // Show substitute info
            const substituteInfo = row.querySelector('.substitute-info');
            if (substituteInfo) {
                substituteInfo.style.display = 'block';
                const originalName = recipeData.ingredients[index].name;
                const originalAmount = recipeData.ingredients[index].amount;
                const originalUnit = recipeData.ingredients[index].unit?.name || '';
                
                // Calculate substitute amount
                const substituteAmount = originalAmount * ratio;
                const displayUnit = substituteUnits || originalUnit;
                
                substituteInfo.querySelector('small').innerHTML = 
                    `Using <strong>${substitute}</strong>: ${formatAmount(substituteAmount)} ${displayUnit} instead of ${formatAmount(originalAmount)} ${originalUnit} ${originalName}`;
            }
            
            // Store the substitution with units
            activeSubstitutions[index] = {
                name: substitute,
                ratio: ratio,
                units: substituteUnits,
                originalName: recipeData.ingredients[index].name,
                originalAmount: recipeData.ingredients[index].amount,
                originalUnit: recipeData.ingredients[index].unit?.name || ''
            };
            
            // Update the needed amount with substitution ratio
            const neededAmount = row.querySelector('.needed-amount');
            const originalAmount = parseFloat(neededAmount.getAttribute('data-original'));
            const newAmount = originalAmount * ratio;
            neededAmount.textContent = formatAmount(newAmount);
            
            // Update unit display in "Recipe Needs" column - ALWAYS update if substituteUnits exists
            const unitDisplay = neededAmount.nextElementSibling;
            if (unitDisplay) {
                // Store original unit if not already stored
                if (!unitDisplay.hasAttribute('data-original-unit')) {
                    unitDisplay.setAttribute('data-original-unit', unitDisplay.textContent.trim());
                }
                
                // Use substitute units if available, otherwise keep original
                if (substituteUnits && substituteUnits.trim() !== '') {
                    unitDisplay.textContent = substituteUnits;
                    console.log(`Updated Recipe Needs unit to: "${substituteUnits}"`);
                } else {
                    console.log(`No substitute units specified, keeping original: "${unitDisplay.textContent}"`);
                }
            }
            
            // Update the "Amount I Have" input and unit selector
            const haveInput = row.querySelector('.have-amount');
            const haveUnitSelect = row.querySelector('.have-unit');
            
            if (haveInput && haveUnitSelect) {
                // Store original values if not already stored
                if (!haveInput.hasAttribute('data-original-value')) {
                    haveInput.setAttribute('data-original-value', haveInput.value);
                }
                if (!haveUnitSelect.hasAttribute('data-original-unit')) {
                    haveUnitSelect.setAttribute('data-original-unit', haveUnitSelect.value);
                }
                
                // Update the "Amount I Have" to use substitute amount
                haveInput.value = newAmount.toString();
                
                // Update the unit selector to show substitute units if available
                if (substituteUnits && substituteUnits.trim() !== '') {
                    // Check if the substitute unit already exists in the dropdown
                    let optionExists = false;
                    for (let option of haveUnitSelect.options) {
                        if (option.value === substituteUnits) {
                            option.selected = true;
                            optionExists = true;
                            break;
                        }
                    }
                    
                    // If substitute unit doesn't exist in dropdown, add it
                    if (!optionExists) {
                        const newOption = document.createElement('option');
                        newOption.value = substituteUnits;
                        newOption.textContent = substituteUnits;
                        newOption.selected = true;
                        haveUnitSelect.insertBefore(newOption, haveUnitSelect.firstChild);
                    }
                    console.log(`Updated Amount I Have unit to: "${substituteUnits}"`);
                }
            }
            
            // Update dropdown button to show active substitute
            const dropdownButton = row.querySelector('[data-dropdown-toggle]');
            if (dropdownButton) {
                let buttonText = `<i class="fas fa-check-circle me-1 text-success"></i>${substitute}`;
                if (substituteUnits && substituteUnits.trim() !== '' && substituteUnits !== (activeSubstitutions[index].originalUnit || '')) {
                    buttonText += ` <small>(${substituteUnits})</small>`;
                }
                dropdownButton.innerHTML = buttonText;
                dropdownButton.classList.remove('btn-outline-primary');
                dropdownButton.classList.add('btn-outline-success');
            }
            
            // Close the dropdown
            const dropdownId = dropdownButton.getAttribute('data-dropdown-toggle');
            const dropdown = document.getElementById(dropdownId);
            if (dropdown) dropdown.style.display = 'none';
            
            // Recalculate everything
            handleIngredientChange({ target: row.querySelector('.have-amount') });
        }
    }

    function removeSubstitution(event) {
        event.preventDefault();
        const index = parseInt(event.target.getAttribute('data-ingredient-index'));
        
        console.log(`❌ Removing substitution for ingredient ${index}`);
        
        const row = document.querySelector(`[data-ingredient="${index}"]`);
        if (row) {
            row.classList.remove('substituted');
            row.querySelector('.substitute-info').style.display = 'none';
            
            // Restore original values in "Recipe Needs" column
            const neededAmount = row.querySelector('.needed-amount');
            const originalAmount = parseFloat(neededAmount.getAttribute('data-original'));
            neededAmount.textContent = formatAmount(originalAmount);
            
            // Restore original unit in "Recipe Needs" column
            const unitDisplay = neededAmount.nextElementSibling;
            if (unitDisplay && unitDisplay.hasAttribute('data-original-unit')) {
                unitDisplay.textContent = unitDisplay.getAttribute('data-original-unit');
                unitDisplay.removeAttribute('data-original-unit');
            }
            
            // Restore original values in "Amount I Have" column
            const haveInput = row.querySelector('.have-amount');
            const haveUnitSelect = row.querySelector('.have-unit');
            
            if (haveInput.hasAttribute('data-original-value')) {
                haveInput.value = haveInput.getAttribute('data-original-value');
                haveInput.removeAttribute('data-original-value');
            }
            
            if (haveUnitSelect.hasAttribute('data-original-unit')) {
                const originalUnit = haveUnitSelect.getAttribute('data-original-unit');
                haveUnitSelect.value = originalUnit;
                haveUnitSelect.removeAttribute('data-original-unit');
                
                // Remove any substitute unit options that were added
                for (let i = haveUnitSelect.options.length - 1; i >= 0; i--) {
                    const option = haveUnitSelect.options[i];
                    if (option.value !== originalUnit && !isStandardUnit(option.value)) {
                        haveUnitSelect.removeChild(option);
                    }
                }
            }
            
            // Remove the substitution
            delete activeSubstitutions[index];
            
            // Reset dropdown button text
            const dropdownButton = row.querySelector('[data-dropdown-toggle]');
            if (dropdownButton) {
                dropdownButton.innerHTML = `<i class="fas fa-exchange-alt me-1"></i>Substitute`;
                dropdownButton.classList.remove('btn-outline-success');
                dropdownButton.classList.add('btn-outline-primary');
            }
            
            // Close the dropdown
            const dropdownId = dropdownButton.getAttribute('data-dropdown-toggle');
            const dropdown = document.getElementById(dropdownId);
            if (dropdown) dropdown.style.display = 'none';
            
            // Recalculate everything
            handleIngredientChange({ target: row.querySelector('.have-amount') });
        }
    }

    // Helper function to check if a unit is one of the standard dropdown units
    function isStandardUnit(unit) {
        const standardUnits = ['cups', 'tbsp', 'tsp', 'oz', 'lb', 'g', 'kg', 'ml', 'l', 'pcs', 'cloves', 'slices'];
        return standardUnits.includes(unit);
    }

    // Add a manual conversion test function for debugging
    window.testConversion = function(amount, from, to) {
        console.log(`🧪 Testing conversion: ${amount} ${from} → ${to}`);
        convertUnits(amount, from, to).then(result => {
            console.log(`✅ Test result: ${amount} ${from} = ${result} ${to}`);
            alert(`${amount} ${from} = ${result} ${to}`);
        });
    };
});
</script>

