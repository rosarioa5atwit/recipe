<%- include('parts/header', { title: 'Recipe Ingredient Manager - ' + recipe.title }) %>

<div class="container-fluid">
    <!-- Header with Recipe Info -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <h5 class="mb-0"><%= recipe.title %></h5>
                            <small class="text-muted">Original: <%= recipe.base_servings %> servings</small>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Target Servings:</label>
                            <input type="number" id="target-servings" class="form-control" 
                                   value="<%= recipe.base_servings %>" min="1" max="50">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Scale:</label>
                            <div class="h4 text-primary" id="scale-display">1.0x</div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Status:</label>
                            <div class="badge bg-success" id="recipe-status">Ready</div>
                        </div>
                        <div class="col-md-2">
                            <a href="/recipes/<%= recipe.id %>" class="btn btn-secondary w-100">
                                ← Back to Recipe
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Main Ingredient Panel -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0"> Ingredient Availability Checker</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ingredient</th>
                                    <th>Recipe Needs</th>
                                    <th>Amount I Have</th>
                                    <th>Adjusted Amount</th>
                                    <th>Substitution</th>
                                </tr>
                            </thead>
                            <tbody id="ingredients-table">
                                <% if (recipe.ingredients && recipe.ingredients.length > 0) { %>
                                    <% recipe.ingredients.forEach((ingredient, index) => { %>
                                        <tr data-ingredient="<%= index %>">
                                            <td>
                                                <div class="fw-bold ingredient-name"><%= ingredient.name %></div>
                                                <div class="substitute-info" style="display: none;">
                                                    <small class="text-warning">Using substitute</small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="needed-amount fw-bold text-primary" data-original="<%= ingredient.amount %>">
                                                    <%= ingredient.amount %>
                                                </span>
                                                <% if (ingredient.unit && ingredient.unit.name) { %>
                                                    <small class="text-muted"><%= ingredient.unit.name %></small>
                                                <% } %>
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" class="form-control form-control-sm have-amount" 
                                                       value="<%= ingredient.amount %>" style="width: 80px;">
                                            </td>
                                            <td>
                                                <span class="adjusted-amount-display badge bg-info" id="adjusted-amount-<%= index %>">
                                                    Enter amounts above
                                                </span>
                                            </td>
                                            <td>
                                                <div class="dropdown">
                                                
                                                    <ul class="dropdown-menu shadow-sm" style="min-width: 200px;">
                                                        <% if (ingredient.substitutions && ingredient.substitutions.length > 0) { %>
                                                            <li><h6 class="dropdown-header text-primary">
                                                                <i class="fas fa-star me-1"></i>Available Substitutes
                                                            </h6></li>
                                                            <% ingredient.substitutions.forEach((sub, subIdx) => { %>
                                                                <li>
                                                                    <a class="dropdown-item substitute-option" href="#" 
                                                                       data-ingredient-index="<%= index %>" 
                                                                       data-substitute="<%= sub.name %>" 
                                                                       data-ratio="<%= sub.ratio || 1 %>">
                                                                        <i class="fas fa-arrow-right me-2 text-muted"></i><%= sub.name %>
                                                                    </a>
                                                                </li>
                                                            <% }); %>
                                                            <li><hr class="dropdown-divider"></li>
                                                            <li>
                                                                <a class="dropdown-item remove-substitute text-danger" href="#" 
                                                                   data-ingredient-index="<%= index %>">
                                                                    <i class="fas fa-times me-2"></i>Remove Substitute
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                <% } else { %>
                                                    <span class="text-muted small">No substitutes available</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">
                                            No ingredients found for this recipe
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
               
            </div>
        </div>

        <!-- Side Panel -->
        <div class="col-lg-4">
            <!-- Quick Stats -->
            <div class="card mb-3">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">📊 Quick Stats</h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="h4 text-success" id="available-count">0</div>
                            <small>Available</small>
                        </div>
                        <div class="col-4">
                            <div class="h4 text-warning" id="partial-count">0</div>
                            <small>Partial</small>
                        </div>
                        <div class="col-4">
                            <div class="h4 text-danger" id="missing-count">0</div>
                            <small>Missing</small>
                        </div>
                    </div>
                    <div class="progress mt-2" style="height: 10px;">
                        <div id="progress-bar" class="progress-bar bg-success" style="width: 100%"></div>
                    </div>
                </div>
            </div>

            <!-- Shopping List -->
            <div class="card mb-3">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0">🛒 Shopping List</h6>
                </div>
                <div class="card-body" style="max-height: 200px; overflow-y: auto;">
                    <div id="shopping-list">
                        <div class="text-muted">All ingredients available!</div>
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-sm btn-outline-primary w-100" onclick="copyShoppingList()">
                        📄 Copy to Clipboard
                    </button>
                </div>
            </div>

            <!-- Substitutions -->
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0">🔄 Active Substitutions</h6>
                </div>
                <div class="card-body" style="max-height: 150px; overflow-y: auto;">
                    <div id="substitutions-list">
                        <div class="text-muted">No substitutions made</div>
                    </div>
                </div>
            </div>
        </div>
    </div>


             

<script>
let originalServings = 4; 
let currentIngredientIndex = 0;

document.addEventListener('DOMContentLoaded', function() {
    const targetServingsInput = document.getElementById('target-servings');
    if (targetServingsInput) {
        originalServings = parseInt(targetServingsInput.value) || 4;
    }
    
    targetServingsInput.addEventListener('change', updateScale);
    
    document.querySelectorAll('.have-amount').forEach((input, index) => {
        const row = input.closest('[data-ingredient]');
        const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
        input.value = neededAmount;
        input.placeholder = 'Enter amount you have';
        
        input.addEventListener('change', () => {
            updateIngredientStatus(index);
            checkForAutoAdjustment();
        });
        
        input.addEventListener('blur', () => {
            updateIngredientStatus(index);
            checkForAutoAdjustment();
        });
    });

    document.querySelectorAll('.substitute-option').forEach(option => {
        option.addEventListener('click', function(e) {
            e.preventDefault();
            console.log('Substitute option clicked:', this.dataset);
            const ingredientIndex = parseInt(this.dataset.ingredientIndex);
            const substituteName = this.dataset.substitute;
            const ratio = parseFloat(this.dataset.ratio);
            console.log(`Applying substitute: ${substituteName} for ingredient ${ingredientIndex} with ratio ${ratio}`);
            applySubstitute(ingredientIndex, substituteName, ratio);
        });
    });
    
    document.querySelectorAll('.remove-substitute').forEach(option => {
        option.addEventListener('click', function(e) {
            e.preventDefault();
            console.log('Remove substitute clicked for ingredient:', this.dataset.ingredientIndex);
            const ingredientIndex = parseInt(this.dataset.ingredientIndex);
            removeSubstitute(ingredientIndex);
        });
    });
    
    console.log('Substitute dropdown listeners attached. Found:', 
                document.querySelectorAll('.substitute-option').length, 'substitute options and',
                document.querySelectorAll('.remove-substitute').length, 'remove options');
    
    updateAllStatuses();
    updateAdjustedAmounts(1.0, true);
});

function checkForAutoAdjustment() {
    const ingredients = document.querySelectorAll('[data-ingredient]');
    let limitingRatio = 1.0;
    let hasUserInputs = false;
    
    ingredients.forEach(row => {
        const haveInput = row.querySelector('.have-amount');
        const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
        
        if (haveInput.value && haveInput.value.trim() !== '') {
            hasUserInputs = true;
            const haveAmount = parseFloat(haveInput.value) || 0;
            const ratio = haveAmount / neededAmount;
            
            if (ratio < limitingRatio) {
                limitingRatio = ratio;
            }
        }
    });
    
    if (hasUserInputs && limitingRatio < 1.0) {
        const newServings = Math.floor(originalServings * limitingRatio);
        if (newServings > 0 && newServings !== parseInt(document.getElementById('target-servings').value)) {
            showAutoAdjustSuggestion(newServings, limitingRatio);
        }
    }
    
    updateAdjustedAmounts(limitingRatio, hasUserInputs);
}

function showAutoAdjustSuggestion(suggestedServings, ratio) {
    const suggestion = document.getElementById('auto-adjust-suggestion');
    if (suggestion) {
        suggestion.remove();
    }
    
    const suggestionHtml = `
        <div id="auto-adjust-suggestion" class="alert alert-info alert-dismissible fade show mt-2" role="alert">
            <strong>💡 Suggestion:</strong> Based on your available ingredients, you could make ${suggestedServings} servings instead. 
            <button type="button" class="btn btn-sm btn-outline-primary ms-2" onclick="applyAutoAdjustment(${suggestedServings})">
                Adjust Recipe
            </button>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    `;
    
    document.querySelector('.container-fluid').insertAdjacentHTML('afterbegin', suggestionHtml);
}

function applyAutoAdjustment(suggestedServings) {
    document.getElementById('target-servings').value = suggestedServings;
    updateScale();
    document.getElementById('auto-adjust-suggestion').remove();
}

function updateAdjustedAmounts(limitingRatio, hasUserInputs) {
    const ingredients = document.querySelectorAll('[data-ingredient]');
    
    ingredients.forEach((row, index) => {
        const adjustedAmountDisplay = document.getElementById(`adjusted-amount-${index}`);
        const haveInput = row.querySelector('.have-amount');
        const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
        
        if (!hasUserInputs) {
            adjustedAmountDisplay.className = 'adjusted-amount-display badge bg-success';
            adjustedAmountDisplay.textContent = 'Can make full recipe';
            return;
        }
        
        if (!haveInput.value || haveInput.value.trim() === '') {
            adjustedAmountDisplay.className = 'adjusted-amount-display badge bg-secondary';
            adjustedAmountDisplay.textContent = 'Enter amount above';
            return;
        }
        
        const haveAmount = parseFloat(haveInput.value) || 0;
        
        const maxUsableAmount = Math.min(haveAmount, neededAmount * limitingRatio);
        const unit = row.querySelector('.needed-amount').nextElementSibling?.textContent || '';
        
        if (limitingRatio >= 1.0) {
            adjustedAmountDisplay.className = 'adjusted-amount-display badge bg-success';
            adjustedAmountDisplay.textContent = `Use ${formatAmount(neededAmount)} ${unit}`;
        } else if (limitingRatio > 0) {
            adjustedAmountDisplay.className = 'adjusted-amount-display badge bg-warning';
            adjustedAmountDisplay.textContent = `Use ${formatAmount(maxUsableAmount)} ${unit}`;
        } else {
            adjustedAmountDisplay.className = 'adjusted-amount-display badge bg-danger';
            adjustedAmountDisplay.textContent = 'Cannot use';
        }
    });
}

function applySubstitute(index, substituteName, ratio) {
    const row = document.querySelector(`[data-ingredient="${index}"]`);
    if (!row) return;
    
    console.log(`Applying substitute: ${substituteName} for ingredient ${index} with ratio ${ratio}`);
    
    const ingredientNameEl = row.querySelector('.ingredient-name');
    const originalName = ingredientNameEl.dataset.original || ingredientNameEl.textContent;
    
    if (!ingredientNameEl.dataset.original) {
        ingredientNameEl.dataset.original = originalName;
    }
    
    ingredientNameEl.innerHTML = `${substituteName} <small class="text-muted">(was ${originalName})</small>`;
    
    const substituteInfo = row.querySelector('.substitute-info');
    substituteInfo.innerHTML = `<small class="text-info">🔄 Using ${substituteName} instead of ${originalName} (${ratio}:1 ratio)</small>`;
    substituteInfo.style.display = 'block';
    
    row.classList.add('substituted');
    
    const targetServings = parseInt(document.getElementById('target-servings').value);
    const scaleFactor = targetServings / originalServings;
    
    const neededAmountElement = row.querySelector('.needed-amount');
    const originalAmount = parseFloat(neededAmountElement.dataset.original);
    const adjustedAmount = originalAmount * ratio * scaleFactor;
    neededAmountElement.textContent = formatAmount(adjustedAmount);
    
    neededAmountElement.dataset.substituteRatio = ratio;
    
    const haveAmountInput = row.querySelector('.have-amount');
    haveAmountInput.value = formatAmount(adjustedAmount);
    
    updateIngredientStatus(index);
    updateSubstitutionsList();
    updateOverallStats();
}

function removeSubstitute(index) {
    const row = document.querySelector(`[data-ingredient="${index}"]`);
    if (!row) return;
    
    console.log(`Removing substitute for ingredient ${index}`);
    
    const ingredientNameEl = row.querySelector('.ingredient-name');
    const originalName = ingredientNameEl.dataset.original;
    
    if (originalName) {
        ingredientNameEl.textContent = originalName;
        ingredientNameEl.removeAttribute('data-original');
    }
    
    const substituteInfo = row.querySelector('.substitute-info');
    substituteInfo.style.display = 'none';
    row.classList.remove('substituted');
    
    const neededAmountElement = row.querySelector('.needed-amount');
    const originalAmount = parseFloat(neededAmountElement.dataset.original);
    const targetServings = parseInt(document.getElementById('target-servings').value);
    const scaleFactor = targetServings / originalServings;
    const scaledAmount = originalAmount * scaleFactor;
    
    neededAmountElement.textContent = formatAmount(scaledAmount);
    neededAmountElement.removeAttribute('data-substitute-ratio');
    
    const haveAmountInput = row.querySelector('.have-amount');
    haveAmountInput.value = formatAmount(scaledAmount);
    
    updateIngredientStatus(index);
    updateSubstitutionsList();
    updateOverallStats();
}

function updateSubstitutionsList() {
    const substitutionsList = document.getElementById('substitutions-list');
    const substitutions = [];
    
    document.querySelectorAll('[data-ingredient].substituted').forEach(row => {
        const substituteInfo = row.querySelector('.substitute-info small').textContent;
        substitutions.push(substituteInfo);
    });
    
    if (substitutions.length === 0) {
        substitutionsList.innerHTML = '<div class="text-muted">No substitutions made</div>';
    } else {
        substitutionsList.innerHTML = substitutions.map(sub => 
            `<div class="mb-1 small text-info">${sub}</div>`
        ).join('');
    }
}

function updateScale() {
    const targetServings = parseInt(document.getElementById('target-servings').value);
    const scaleFactor = targetServings / originalServings;
    
    document.getElementById('scale-display').textContent = scaleFactor.toFixed(1) + 'x';
    
    document.querySelectorAll('.needed-amount').forEach(element => {
        const originalAmount = parseFloat(element.dataset.original);
        const substituteRatio = parseFloat(element.dataset.substituteRatio) || 1;
        const scaledAmount = originalAmount * scaleFactor * substituteRatio;
        element.textContent = formatAmount(scaledAmount);
    });
    
    updateAllStatuses();
}

function updateAllStatuses() {
    document.querySelectorAll('[data-ingredient]').forEach((row, index) => {
        updateIngredientStatus(index);
    });
    updateOverallStats();
}

function updateIngredientStatus(index) {
    const row = document.querySelector(`[data-ingredient="${index}"]`);
    if (!row) return;
    
    const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
    const haveInput = row.querySelector('.have-amount');
    
    const wasSubstituted = row.classList.contains('substituted');
    row.classList.remove('insufficient', 'partial');
    if (wasSubstituted) row.classList.add('substituted');
    
    const haveAmount = parseFloat(haveInput.value) || 0;
    
    if (haveAmount >= neededAmount) {
        haveInput.style.borderColor = '#198754';
    } else if (haveAmount > 0) {
        row.classList.add('partial');
        haveInput.style.borderColor = '#ffc107';
    } else {
        row.classList.add('insufficient');
        haveInput.style.borderColor = '#dc3545';
    }
}

function updateOverallStats() {
    const rows = document.querySelectorAll('[data-ingredient]');
    let available = 0, partial = 0, missing = 0;
    
    rows.forEach(row => {
        const haveInput = row.querySelector('.have-amount');
        const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
        const haveAmount = parseFloat(haveInput.value) || 0;
        
        if (haveAmount >= neededAmount) {
            available++;
        } else if (haveAmount > 0) {
            partial++;
        } else {
            missing++;
        }
    });
    
    document.getElementById('available-count').textContent = available;
    document.getElementById('partial-count').textContent = partial;
    document.getElementById('missing-count').textContent = missing;
    
    const total = rows.length;
    const progressPercent = total > 0 ? Math.round((available / total) * 100) : 100;
    document.getElementById('progress-bar').style.width = progressPercent + '%';
    
    const statusEl = document.getElementById('recipe-status');
    if (missing === 0 && partial === 0) {
        statusEl.className = 'badge bg-success';
        statusEl.textContent = 'Ready to Cook!';
    } else if (progressPercent >= 75) {
        statusEl.className = 'badge bg-warning';
        statusEl.textContent = 'Almost Ready';
    } else {
        statusEl.className = 'badge bg-danger';
        statusEl.textContent = 'Need Ingredients';
    }
    
    updateShoppingList();
}

function updateShoppingList() {
    const shoppingList = document.getElementById('shopping-list');
    const items = [];
    
    document.querySelectorAll('[data-ingredient]').forEach(row => {
        const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
        const haveInput = row.querySelector('.have-amount');
        
        // Only add to shopping list if user specified they have less than needed
        if (haveInput.value && haveInput.value.trim() !== '') {
            const haveAmount = parseFloat(haveInput.value) || 0;
            
            if (haveAmount < neededAmount) {
                const name = row.querySelector('.ingredient-name').textContent;
                const needToBuy = neededAmount - haveAmount;
                const unit = row.querySelector('.needed-amount').nextElementSibling?.textContent || '';
                items.push(`${formatAmount(needToBuy)} ${unit} ${name}`.trim());
            }
        }
    });
    
    if (items.length === 0) {
        shoppingList.innerHTML = '<div class="text-muted">Enter ingredient amounts to generate shopping list</div>';
    } else {
        shoppingList.innerHTML = items.map(item => 
            `<div class="mb-1">• ${item}</div>`
        ).join('');
    }
}

function setAllAvailable() {
    document.querySelectorAll('.have-amount').forEach((input, index) => {
        const row = input.closest('[data-ingredient]');
        const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
        input.value = neededAmount;
        updateIngredientStatus(index);
    });
    checkForAutoAdjustment();
}

function setAllMissing() {
    document.querySelectorAll('.have-amount').forEach((input, index) => {
        input.value = 0;
        updateIngredientStatus(index);
    });
    checkForAutoAdjustment();
}

function setHalfAmounts() {
    document.querySelectorAll('.have-amount').forEach((input, index) => {
        const row = input.closest('[data-ingredient]');
        const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
        input.value = neededAmount / 2;
        updateIngredientStatus(index);
    });
    checkForAutoAdjustment();
}

function formatAmount(amount) {
    if (amount === Math.floor(amount)) return amount.toString();
    if (Math.abs(amount - 0.5) < 0.01) return '½';
    if (Math.abs(amount - 0.25) < 0.01) return '¼';
    if (Math.abs(amount - 0.75) < 0.01) return '¾';
    if (Math.abs(amount - 1.5) < 0.01) return '1½';
    return amount.toFixed(2).replace(/\.?0+$/, '');
}

function generateShoppingList() {
    const items = [];
    document.querySelectorAll('[data-ingredient]').forEach(row => {
        const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
        const haveAmount = parseFloat(row.querySelector('.have-amount').value) || 0;
        
        if (haveAmount < neededAmount) {
            const name = row.querySelector('.ingredient-name').textContent;
            const needToBuy = neededAmount - haveAmount;
            const unit = row.querySelector('.needed-amount').nextElementSibling?.textContent || '';
            items.push(`${formatAmount(needToBuy)} ${unit} ${name}`.trim());
        }
    });
    
    if (items.length === 0) {
        alert('Great! You have all ingredients needed.');
    } else {
        const listText = 'Shopping List:\n\n' + items.map(item => `• ${item}`).join('\n');
        alert(listText);
    }
}

function copyShoppingList() {
    const items = [];
    document.querySelectorAll('[data-ingredient]').forEach(row => {
        const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
        const haveAmount = parseFloat(row.querySelector('.have-amount').value) || 0;
        
        if (haveAmount < neededAmount) {
            const name = row.querySelector('.ingredient-name').textContent;
            const needToBuy = neededAmount - haveAmount;
            const unit = row.querySelector('.needed-amount').nextElementSibling?.textContent || '';
            items.push(`${formatAmount(needToBuy)} ${unit} ${name}`.trim());
        }
    });
    
    const listText = items.map(item => `• ${item}`).join('\n');
    navigator.clipboard.writeText(listText).then(() => {
        alert('Shopping list copied to clipboard!');
    });
}

function savePreferences() {
    alert('Preferences saved! (This would save to your profile in a full app)');
}

function applyMaximumRecipe() {
    const ingredients = document.querySelectorAll('[data-ingredient]');
    let limitingRatio = 1.0;
    let hasUserInputs = false;
    
    ingredients.forEach(row => {
        const haveInput = row.querySelector('.have-amount');
        const neededAmount = parseFloat(row.querySelector('.needed-amount').textContent);
        
        if (haveInput.value && haveInput.value.trim() !== '') {
            hasUserInputs = true;
            const haveAmount = parseFloat(haveInput.value) || 0;
            const ratio = haveAmount / neededAmount;
            
            if (ratio < limitingRatio) {
                limitingRatio = ratio;
            }
        }
    });
    
    if (!hasUserInputs) {
        alert('Please enter ingredient amounts first');
        return;
    }
    
    const maxServings = Math.floor(originalServings * limitingRatio);
    if (maxServings > 0) {
        document.getElementById('target-servings').value = maxServings;
        updateScale();
        
        updateAllStatuses();
        checkForAutoAdjustment();
        
        const suggestion = document.getElementById('auto-adjust-suggestion');
        if (suggestion) {
            suggestion.remove();
        }
        const suggestionHtml = `
            <div id="auto-adjust-suggestion" class="alert alert-success alert-dismissible fade show mt-2" role="alert">
                <strong>✅ Recipe adjusted!</strong> Maximum possible servings set to ${maxServings}.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;
        document.querySelector('.container-fluid').insertAdjacentHTML('afterbegin', suggestionHtml);
        
        setTimeout(() => {
            const msg = document.getElementById('auto-adjust-suggestion');
            if (msg) msg.remove();
        }, 3000);
    } else {
        alert('Not enough ingredients to make any servings.');
    }
}
