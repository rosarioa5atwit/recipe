<%- include('parts/header', { title: 'Adjust Recipe - ' + recipe.title }) %>

<div class="container-fluid">
    <div class="row">
        <!-- Left Panel - Recipe Info -->
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📋 Original Recipe</h5>
                </div>
                <div class="card-body">
                    <h6 class="card-title"><%= recipe.title %></h6>
                    
                    <div class="mb-3">
                        <strong>Original Servings:</strong> <%= recipe.base_servings %>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted">Prep Time</small><br>
                            <span class="badge bg-info"><%= recipe.prep_time || 0 %>min</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Cook Time</small><br>
                            <span class="badge bg-warning"><%= recipe.cook_time || 0 %>min</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Instructions:</strong>
                        <div class="mt-2" style="max-height: 200px; overflow-y: auto; font-size: 0.9em;">
                            <% if (recipe.instructions) { %>
                                <div style="white-space: pre-line;"><%= recipe.instructions %></div>
                            <% } else { %>
                                <em class="text-muted">No instructions provided</em>
                            <% } %>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a href="/recipes/<%= recipe.id %>" class="btn btn-outline-primary btn-sm">← Back to Recipe</a>
                        <a href="/recipes" class="btn btn-outline-secondary btn-sm">← All Recipes</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Center Panel - Adjustment Controls -->
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">⚖️ Adjust Recipe</h5>
                </div>
                <div class="card-body text-center">
                    <!-- Current Servings Display -->
                    <div class="mb-4">
                        <h3 class="display-4 text-primary" id="current-servings"><%= recipe.base_servings %></h3>
                        <h6 class="text-muted">Current Servings</h6>
                        <small class="text-muted">
                            Scale Factor: <span id="scale-factor" class="fw-bold">1.0</span>x
                        </small>
                    </div>

                    <!-- Manual Input -->
                    <div class="mb-4">
                        <label for="custom-servings" class="form-label">Enter Servings:</label>
                        <div class="input-group">
                            <input type="number" 
                                   class="form-control text-center" 
                                   id="custom-servings" 
                                   min="1" 
                                   max="100" 
                                   value="<%= recipe.base_servings %>"
                                   onchange="setServings(this.value)">
                            <button class="btn btn-outline-secondary" onclick="resetServings()">Reset</button>
                        </div>
                    </div>

                    <!-- Quick Adjustment Buttons -->
                    <div class="mb-4">
                        <h6>Quick Adjustments:</h6>
                        <div class="d-grid gap-2">
                            <div class="btn-group" role="group">
                                <button class="btn btn-outline-danger" onclick="adjustServings(-2)">-2</button>
                                <button class="btn btn-outline-danger" onclick="adjustServings(-1)">-1</button>
                                <button class="btn btn-outline-success" onclick="adjustServings(1)">+1</button>
                                <button class="btn btn-outline-success" onclick="adjustServings(2)">+2</button>
                            </div>
                        </div>
                    </div>

                    <!-- Preset Servings -->
                    <div class="mb-4">
                        <h6>Common Serving Sizes:</h6>
                        <div class="d-grid gap-2">
                            <div class="btn-group" role="group">
                                <button class="btn btn-primary btn-sm" onclick="setServings(2)">2</button>
                                <button class="btn btn-primary btn-sm" onclick="setServings(4)">4</button>
                                <button class="btn btn-primary btn-sm" onclick="setServings(6)">6</button>
                                <button class="btn btn-primary btn-sm" onclick="setServings(8)">8</button>
                            </div>
                            <div class="btn-group" role="group">
                                <button class="btn btn-warning btn-sm" onclick="setServings(12)">12</button>
                                <button class="btn btn-warning btn-sm" onclick="setServings(16)">16</button>
                                <button class="btn btn-warning btn-sm" onclick="setServings(20)">20</button>
                                <button class="btn btn-warning btn-sm" onclick="setServings(24)">24</button>
                            </div>
                        </div>
                    </div>

                    <!-- Special Scaling Options -->
                    <div class="mb-3">
                        <h6>Special Scaling:</h6>
                        <div class="d-grid gap-1">
                            <button class="btn btn-outline-info btn-sm" onclick="setServings(<%= recipe.base_servings * 1.5 %>)">1.5x Original</button>
                            <button class="btn btn-outline-info btn-sm" onclick="setServings(<%= recipe.base_servings * 2 %>)">Double</button>
                            <button class="btn btn-outline-info btn-sm" onclick="setServings(<%= recipe.base_servings * 3 %>)">Triple</button>
                            <button class="btn btn-outline-info btn-sm" onclick="setServings(<%= Math.ceil(recipe.base_servings / 2) %>)">Half</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Panel - Scaled Ingredients -->
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">🧮 Scaled Ingredients</h5>
                </div>
                <div class="card-body">
                    <div id="ingredients-list">
                        <h6 class="text-center text-muted mb-4">Sample Ingredients for Demo:</h6>
                        
                        <div class="ingredient-item mb-3 p-2 border rounded">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="ingredient-name">Flour</span>
                                <span class="ingredient-amount">
                                    <span data-original-amount="2" class="scaled-amount">2</span> cups
                                </span>
                            </div>
                        </div>

                        <div class="ingredient-item mb-3 p-2 border rounded">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="ingredient-name">Sugar</span>
                                <span class="ingredient-amount">
                                    <span data-original-amount="1" class="scaled-amount">1</span> cup
                                </span>
                            </div>
                        </div>

                        <div class="ingredient-item mb-3 p-2 border rounded">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="ingredient-name">Butter</span>
                                <span class="ingredient-amount">
                                    <span data-original-amount="0.5" class="scaled-amount">½</span> cup
                                </span>
                            </div>
                        </div>

                        <div class="ingredient-item mb-3 p-2 border rounded">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="ingredient-name">Eggs</span>
                                <span class="ingredient-amount">
                                    <span data-original-amount="3" class="scaled-amount">3</span> large
                                </span>
                            </div>
                        </div>

                        <div class="ingredient-item mb-3 p-2 border rounded">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="ingredient-name">Vanilla Extract</span>
                                <span class="ingredient-amount">
                                    <span data-original-amount="1" class="scaled-amount">1</span> tsp
                                </span>
                            </div>
                        </div>

                        <div class="ingredient-item mb-3 p-2 border rounded">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="ingredient-name">Baking Powder</span>
                                <span class="ingredient-amount">
                                    <span data-original-amount="2" class="scaled-amount">2</span> tsp
                                </span>
                            </div>
                        </div>

                        <div class="ingredient-item mb-3 p-2 border rounded">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="ingredient-name">Salt</span>
                                <span class="ingredient-amount">
                                    <span data-original-amount="0.5" class="scaled-amount">½</span> tsp
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 text-center">
                        <button class="btn btn-success" onclick="window.print()">
                            🖨️ Print Scaled Recipe
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.ingredient-item {
    transition: all 0.3s ease;
}

.ingredient-item:hover {
    background-color: #f8f9fa;
    transform: translateX(5px);
}

.scaled-amount {
    font-weight: bold;
    color: #0d6efd;
    font-size: 1.1em;
}

.scaled-amount.changed {
    color: #dc3545;
    animation: pulse 0.5s ease-in-out;
}

@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
}

@media print {
    .col-md-4:first-child, .col-md-4:nth-child(2) {
        display: none;
    }
    .col-md-4:last-child {
        width: 100%;
    }
}
</style>

<script>
// Recipe scaling functionality for dedicated adjustment page
const originalServings = <%= recipe.base_servings %>;
let currentServings = originalServings;

function adjustServings(change) {
    const newServings = currentServings + change;
    if (newServings > 0) {
        setServings(newServings);
    }
}

function setServings(servings) {
    servings = Math.max(1, Math.min(100, parseInt(servings))); // Limit between 1-100
    currentServings = servings;
    const scaleFactor = servings / originalServings;
    
    // Update displays
    document.getElementById('current-servings').textContent = servings;
    document.getElementById('scale-factor').textContent = scaleFactor.toFixed(1);
    document.getElementById('custom-servings').value = servings;
    
    // Update all ingredient amounts
    const scaledAmounts = document.querySelectorAll('[data-original-amount]');
    scaledAmounts.forEach(element => {
        const originalAmount = parseFloat(element.dataset.originalAmount);
        const scaledAmount = originalAmount * scaleFactor;
        
        // Add animation class
        element.classList.add('changed');
        setTimeout(() => element.classList.remove('changed'), 500);
        
        element.textContent = formatAmount(scaledAmount);
    });
    
    // Highlight current servings if different from original
    const currentServingsElement = document.getElementById('current-servings');
    if (scaleFactor !== 1.0) {
        currentServingsElement.classList.add('text-danger');
        currentServingsElement.parentElement.classList.add('border', 'border-warning');
    } else {
        currentServingsElement.classList.remove('text-danger');
        currentServingsElement.classList.add('text-primary');
        currentServingsElement.parentElement.classList.remove('border', 'border-warning');
    }
}

function resetServings() {
    setServings(originalServings);
}

function formatAmount(amount) {
    // Handle special fractions and decimals
    if (amount === Math.floor(amount)) {
        return amount.toString();
    } else if (Math.abs(amount - 0.25) < 0.01) {
        return '¼';
    } else if (Math.abs(amount - 0.33) < 0.01) {
        return '⅓';
    } else if (Math.abs(amount - 0.5) < 0.01) {
        return '½';
    } else if (Math.abs(amount - 0.67) < 0.01) {
        return '⅔';
    } else if (Math.abs(amount - 0.75) < 0.01) {
        return '¾';
    } else if (Math.abs(amount - 1.25) < 0.01) {
        return '1¼';
    } else if (Math.abs(amount - 1.33) < 0.01) {
        return '1⅓';
    } else if (Math.abs(amount - 1.5) < 0.01) {
        return '1½';
    } else if (Math.abs(amount - 1.67) < 0.01) {
        return '1⅔';
    } else if (Math.abs(amount - 1.75) < 0.01) {
        return '1¾';
    } else if (Math.abs(amount - 2.5) < 0.01) {
        return '2½';
    } else {
        return amount.toFixed(2).replace(/\.?0+$/, '');
    }
}

// Initialize page
document.addEventListener('DOMContentLoaded', function() {
    resetServings();
});
</script>

<%- include('parts/footer') %>
