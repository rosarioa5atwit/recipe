<%- include('parts/header', { title: 'Dashboard' }) %>

<div class="container">
    <h1>Welcome to Your Recipe Dashboard</h1>
    
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Hello, <%= userEmail %>!</h5>
                    <p class="card-text">You're successfully logged in to your recipe account.</p>
                    <a href="/recipes" class="btn btn-primary">View My Recipes</a>
                    <a href="/recipes/new" class="btn btn-outline-primary">Add New Recipe</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Quick Actions</h5>
                    <div class="d-grid gap-2">
                        <a href="/recipes" class="btn btn-outline-secondary">Browse Recipes</a>
                        <a href="/logout" class="btn btn-outline-danger">Logout</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('parts/footer') %>
