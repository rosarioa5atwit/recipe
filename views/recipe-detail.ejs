<%- include('parts/header', { title: recipe.title }) %>

<div class="container">
    <div class="row">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><%= recipe.title %></h1>
                <a href="/recipes" class="btn btn-outline-secondary">← Back to Recipes</a>
            </div>
            
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <h6 class="text-muted">Servings</h6>
                            <div class="d-flex align-items-center">
                                <button class="btn btn-outline-secondary btn-sm" onclick="adjustServings(-1)">-</button>
                                <span class="mx-3">
                                    <span id="current-servings"><%= recipe.base_servings %></span>
                                    <small class="text-muted">(original: <%= recipe.base_servings %>)</small>
                                </span>
                                <button class="btn btn-outline-secondary btn-sm" onclick="adjustServings(1)">+</button>
                            </div>
                            <small class="text-muted mt-1 d-block">
                                Scale: <span id="scale-factor">1.0</span>x
                            </small>
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-muted">Prep Time</h6>
                            <p class="mb-0"><%= recipe.prep_time || 0 %> minutes</p>
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-muted">Cook Time</h6>
                            <p class="mb-0"><%= recipe.cook_time || 0 %> minutes</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Demo Ingredients Section (for scaling demonstration) -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Ingredients <small class="text-muted">(Demo - shows scaling)</small></h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <span data-original-amount="2">2</span> cups flour
                        </li>
                        <li class="mb-2">
                            <span data-original-amount="1">1</span> cup sugar
                        </li>
                        <li class="mb-2">
                            <span data-original-amount="0.5">½</span> cup butter
                        </li>
                        <li class="mb-2">
                            <span data-original-amount="3">3</span> eggs
                        </li>
                        <li class="mb-2">
                            <span data-original-amount="1">1</span> tsp vanilla extract
                        </li>
                    </ul>
                    <small class="text-muted">
                        💡 Tip: Use the serving adjustment buttons above to see ingredients scale automatically!
                    </small>
                </div>
            </div>

            <% if (recipe.instructions) { %>
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Instructions</h5>
                    </div>
                    <div class="card-body">
                        <div style="white-space: pre-line;"><%= recipe.instructions %></div>
                    </div>
                </div>
            <% } else { %>
                <div class="alert alert-info">
                    <p class="mb-0">No instructions provided for this recipe.</p>
                </div>
            <% } %>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recipe Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/recipes/<%= recipe.id %>/adjust" class="btn btn-primary">⚖️ Adjust Recipe Portions</a>
                        <button class="btn btn-outline-primary" onclick="window.print()">🖨️ Print Recipe</button>
                        <a href="/recipes/<%= recipe.id %>/edit" class="btn btn-outline-warning">✏️ Edit Recipe</a>
                        <button class="btn btn-outline-danger" onclick="deleteRecipe('<%= recipe.id %>')">🗑️ Delete Recipe</button>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">Recipe Info</h5>
                </div>
                <div class="card-body">
                    <small class="text-muted">
                        Created: <%= new Date(recipe.created_at).toLocaleDateString() %><br>
                        <% if (recipe.updated_at && recipe.updated_at !== recipe.created_at) { %>
                            Updated: <%= new Date(recipe.updated_at).toLocaleDateString() %>
                        <% } %>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Recipe scaling functionality
const originalServings = <%= typeof recipe.base_servings !== 'undefined' ? recipe.base_servings : 1 %>;
let currentServings = originalServings;

// Output recipe data to console
console.log('*** RECIPE DATA ***');
console.log('Title:', '<%= recipe.title %>');
console.log('Servings:', <%= recipe.base_servings || 1 %>);
console.log('Prep Time:', <%= recipe.prep_time || 0 %>, 'minutes');
console.log('Cook Time:', <%= recipe.cook_time || 0 %>, 'minutes');
console.log('Instructions:', `<%= recipe.instructions ? recipe.instructions.replace(/\n/g, '\\n') : 'No instructions' %>`);
console.log('Created:', '<%= new Date(recipe.created_at).toLocaleDateString() %>');
console.log('Recipe ID:', '<%= recipe.id %>');
console.log('*** END RECIPE ***');

function adjustServings(change) {
    const newServings = currentServings + change;
    if (newServings > 0) {
        setServings(newServings);
    }
}

function setServings(servings) {
    currentServings = servings;
    const scaleFactor = servings / originalServings;
    
    document.getElementById('current-servings').textContent = servings;
    document.getElementById('scale-factor').textContent = scaleFactor.toFixed(1);
    
    // Update any ingredient quantities (if they exist and have data attributes)
    const ingredientElements = document.querySelectorAll('[data-original-amount]');
    ingredientElements.forEach(element => {
        const originalAmount = parseFloat(element.dataset.originalAmount);
        const scaledAmount = originalAmount * scaleFactor;
        element.textContent = formatAmount(scaledAmount);
    });
    
    // Highlight when scaled
    const currentServingsElement = document.getElementById('current-servings');
    if (scaleFactor !== 1.0) {
        currentServingsElement.classList.add('fw-bold', 'text-primary');
    } else {
        currentServingsElement.classList.remove('fw-bold', 'text-primary');
    }
}

function resetServings() {
    setServings(originalServings);
}

function formatAmount(amount) {
    // Format numbers nicely (e.g., 1.5, 2, 0.25 → ¼)
    if (amount === Math.floor(amount)) {
        return amount.toString();
    } else if (amount === 0.25) {
        return '¼';
    } else if (amount === 0.33) {
        return '⅓';
    } else if (amount === 0.5) {
        return '½';
    } else if (amount === 0.67) {
        return '⅔';
    } else if (amount === 0.75) {
        return '¾';
    } else {
        return amount.toFixed(2).replace(/\.?0+$/, '');
    }
}

function deleteRecipe(recipeId) {
    if (confirm('Are you sure you want to delete this recipe? This action cannot be undone.')) {
        fetch(`/recipes/${recipeId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => {
            if (response.ok) {
                window.location.href = '/recipes';
            } else {
                alert('Failed to delete recipe. Please try again.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to delete recipe. Please try again.');
        });
    }
}

// Load data when page loads
document.addEventListener('DOMContentLoaded', function() {
    console.log('*** RECIPE DETAIL PAGE ***');
    console.log('Recipe Title:', '<%= recipe.title %>');
    console.log('Servings:', <%= recipe.base_servings || 1 %>);
    console.log('Instructions:', `<%= recipe.instructions ? recipe.instructions.replace(/\n/g, '\\n').replace(/'/g, "\\'") : 'No instructions' %>`);
    console.log('*** END RECIPE DETAIL ***');
});
</script>

<%- include('parts/footer') %>
