<%- include('parts/header', { title: 'Add Recipe' }) %>

<div class="container">
    <h1>Add New Recipe</h1>
    
    <form id="recipeForm" action="/recipes" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
            <label for="title" class="form-label">Recipe Title *</label>
            <input type="text" class="form-control" id="title" name="title" required>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label for="servings" class="form-label">Servings *</label>
                <input type="number" class="form-control" id="servings" name="servings" min="1" required>
            </div>
            <div class="col-md-4 mb-3">
                <label for="prep_time" class="form-label">Prep Time (minutes)</label>
                <input type="number" class="form-control" id="prep_time" name="prep_time" min="0">
            </div>
            <div class="col-md-4 mb-3">
                <label for="cook_time" class="form-label">Cook Time (minutes)</label>
                <input type="number" class="form-control" id="cook_time" name="cook_time" min="0">
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Ingredients *</label>
            <div id="ingredients-container">
                <div class="ingredient-row mb-2">
                    <div class="row">
                        <div class="col-md-3">
                            <input type="number" step="0.01" class="form-control" name="ingredients[0][amount]" placeholder="Amount" required>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select unit-dropdown" name="ingredients[0][unit]" data-index="0">
                                <option value="">Select unit...</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <select class="form-select ingredient-dropdown" name="ingredients[0][name]" data-index="0" required>
                                <option value="">Select ingredient...</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <button type="button" class="btn btn-outline-danger remove-ingredient">×</button>
                        </div>
                    </div>
                </div>
            </div>
            <button type="button" id="add-ingredient" class="btn btn-outline-secondary">+ Add Ingredient</button>
        </div>

        <div class="mb-3">
            <label for="instructions" class="form-label">Instructions *</label>
            <textarea class="form-control" id="instructions" name="instructions" rows="6" required></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Recipe</button>
            <a href="/recipes" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script>
let ingredientCount = 1;
let ingredientsData = [];
let unitsData = [];

async function fetchIngredients() {
    if (ingredientsData.length > 0) return; 
    
    try {
        console.log('Fetching ingredients from API...');
        const response = await fetch('/api/ingredients');
        
        if (!response.ok) {
            throw new Error('Failed to fetch ingredients');
        }
        
        const data = await response.json();
        console.log('*** INGREDIENTS FETCHED ***');
        if (data && data.length > 0) {
            data.forEach((ingredient, index) => {
                console.log(`${index + 1}. ${ingredient.name}`);
            });
            ingredientsData = data;
            populateIngredientDropdowns();
        } else {
            console.log('No ingredients found');
        }
        console.log('*** END INGREDIENTS ***');
    } catch (error) {
        console.error('Error fetching ingredients:', error);
    }
}

async function fetchUnits() {
    if (unitsData.length > 0) return; 
    
    try {
        console.log('Fetching units from API...');
        const response = await fetch('/api/units');
        
        if (!response.ok) {
            throw new Error('Failed to fetch units');
        }
        
        const data = await response.json();
        console.log('Units fetched:', data.length);
        if (data && data.length > 0) {
            unitsData = data;
            populateUnitDropdowns();
        }
    } catch (error) {
        console.error('Error fetching units:', error);
    }
}

function populateIngredientDropdowns() {
    const dropdowns = document.querySelectorAll('.ingredient-dropdown');
    dropdowns.forEach(dropdown => {
        if (dropdown.children.length <= 1) {
            ingredientsData.forEach(ingredient => {
                const option = document.createElement('option');
                option.value = ingredient.name;
                option.textContent = ingredient.name;
                dropdown.appendChild(option);
            });
        }
    });
}

function populateUnitDropdowns() {
    const dropdowns = document.querySelectorAll('.unit-dropdown');
    dropdowns.forEach(dropdown => {
        if (dropdown.children.length <= 1) {
            unitsData.forEach(unit => {
                const option = document.createElement('option');
                option.value = unit.name;
                option.textContent = unit.name;
                dropdown.appendChild(option);
            });
        }
    });
}

document.getElementById('add-ingredient').addEventListener('click', function() {
    const container = document.getElementById('ingredients-container');
    const div = document.createElement('div');
    div.className = 'ingredient-row mb-2';
    div.innerHTML = `
        <div class="row">
            <div class="col-md-3">
                <input type="number" step="0.01" class="form-control" name="ingredients[${ingredientCount}][amount]" placeholder="Amount" required>
            </div>
            <div class="col-md-3">
                <select class="form-select unit-dropdown" name="ingredients[${ingredientCount}][unit]" data-index="${ingredientCount}">
                    <option value="">Select unit...</option>
                </select>
            </div>
            <div class="col-md-5">
                <select class="form-select ingredient-dropdown" name="ingredients[${ingredientCount}][name]" data-index="${ingredientCount}" required>
                    <option value="">Select ingredient...</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-outline-danger remove-ingredient">×</button>
            </div>
        </div>
    `;
    container.appendChild(div);
    
    const newIngredientDropdown = div.querySelector('.ingredient-dropdown');
    const newUnitDropdown = div.querySelector('.unit-dropdown');
    
    if (ingredientsData.length > 0) {
        ingredientsData.forEach(ingredient => {
            const option = document.createElement('option');
            option.value = ingredient.name;
            option.textContent = ingredient.name;
            newIngredientDropdown.appendChild(option);
        });
    }
    
    if (unitsData.length > 0) {
        unitsData.forEach(unit => {
            const option = document.createElement('option');
            option.value = unit.name;
            option.textContent = unit.name;
            newUnitDropdown.appendChild(option);
        });
    }
    
    ingredientCount++;
});

document.addEventListener('click', function(e) {
    if (e.target.classList.contains('remove-ingredient')) {
        e.target.closest('.ingredient-row').remove();
    }
});

document.getElementById('recipeForm').addEventListener('submit', function(e) {
    console.log('*** FORM SUBMISSION DEBUG ***');
    
    const formData = new FormData(this);
    console.log('Form data entries:');
    for (let [key, value] of formData.entries()) {
        console.log(`${key}: "${value}"`);
    }
    
    const ingredients = [];
    const ingredientRows = document.querySelectorAll('.ingredient-row');
    
    console.log(`Found ${ingredientRows.length} ingredient rows`);
    
    ingredientRows.forEach((row, index) => {
        const amount = row.querySelector(`input[name*="[amount]"]`)?.value;
        const unit = row.querySelector(`select[name*="[unit]"]`)?.value;
        const name = row.querySelector(`select[name*="[name]"]`)?.value;
        
        const ingredient = { amount, unit, name };
        console.log(`Ingredient ${index + 1}:`, ingredient);
        
        if (!amount || !name) {
            console.warn(`Ingredient ${index + 1} is missing required data!`);
        }
        
        ingredients.push(ingredient);
    });
    
    console.log('*** END FORM SUBMISSION DEBUG ***');
    
});

document.addEventListener('DOMContentLoaded', function() {
    console.log('Page loaded, fetching data...');
    fetchIngredients();
    fetchUnits();
});
</script>

<%- include('parts/footer') %>