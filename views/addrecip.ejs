<%- include('parts/header', { title: 'Add Recipe' }) %>

<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow">
        <div class="card-body p-4">
          <h2 class="mb-4">Create New Recipe</h2>
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <form id="recipeForm" action="/recipes" method="POST" enctype="multipart/form-data">
            <!-- Optionally include user id as a hidden field if available -->
            <% if (typeof user !== 'undefined' && user && user.id) { %>
              <input type="hidden" name="user_id" value="<%= user.id %>">
            <% } %>
            <!-- Basic Info -->
            <div class="mb-4">
              <div class="mb-3">
                <label for="title" class="form-label">Recipe Title</label>
                <input 
                  type="text" 
                  class="form-control" 
                  id="title" 
                  name="title" 
                  required
                  placeholder="e.g. Grandma's Chocolate Chip Cookies"
                >
              </div>
              
              <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea 
                  class="form-control" 
                  id="description" 
                  name="description" 
                  rows="2"
                  placeholder="What makes this recipe special?"
                ></textarea>
              </div>
              
              <div class="row">
                <div class="col-md-4 mb-3">
                  <label for="prepTime" class="form-label">Prep Time (mins)</label>
                  <input 
                    type="number" 
                    class="form-control" 
                    id="prepTime" 
                    name="prepTime" 
                    min="0"
                  >
                </div>
                <div class="col-md-4 mb-3">
                  <label for="cookTime" class="form-label">Cook Time (mins)</label>
                  <input 
                    type="number" 
                    class="form-control" 
                    id="cookTime" 
                    name="cookTime" 
                    min="0"
                  >
                </div>
                <div class="col-md-4 mb-3">
                  <label for="servings" class="form-label">Servings</label>
                  <input 
                    type="number" 
                    class="form-control" 
                    id="servings" 
                    name="servings" 
                    min="1"
                    value="4"
                  >
                </div>
              </div>
            </div>
            
            <!-- Image Upload -->
            <div class="mb-4">
              <label for="recipeImage" class="form-label">Recipe Image</label>
              <input 
                type="file" 
                class="form-control" 
                id="recipeImage" 
                name="image"
                accept="image/*"
              >
              <div class="preview-container mt-2" id="imagePreview" style="display:none;">
                <img id="previewImage" class="img-thumbnail" style="max-height: 200px;">
              </div>
            </div>
            


            <!-- Ingredients Section -->
            <div class="mb-4">
              <h4 class="d-flex justify-content-between align-items-center">
                Ingredients
              </h4>
              <div class="row g-2 mb-2">
                <div class="col-sm-6">
                  <input 
                    type="text" 
                    class="form-control" 
                    id="ingredientNameInput"
                    placeholder="Ingredient name"
                  >
                </div>
                <div class="col-sm-3">
                  <input 
                    type="text" 
                    class="form-control" 
                    id="ingredientUnitInput"
                    placeholder="Unit (e.g. cups, tsp)"
                  >
                </div>
                <div class="col-sm-3">
                  <button type="button" id="addIngredientBtn" class="btn btn-primary w-100">
                    <i class="bi bi-plus"></i> Add Ingredient
                  </button>
                </div>
              </div>
              <div id="ingredientsContainer">
                <!-- Added ingredients will appear here -->
              </div>
            </div>
            
            <!-- Instructions -->
            <div class="mb-4">
              <h4>Instructions</h4>
              <div id="instructionsContainer">
                <div class="instruction-step mb-3">
                  <div class="input-group">
                    <span class="input-group-text">1</span>
                    <textarea 
                      class="form-control" 
                      name="instructions[]" 
                      placeholder="Describe this step..."
                      required
                    ></textarea>
                    <button type="button" class="btn btn-outline-danger remove-step" disabled>
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </div>
              </div>
              <button type="button" id="addStepBtn" class="btn btn-sm btn-outline-primary mt-2">
                <i class="bi bi-plus"></i> Add Step
              </button>
            </div>
            <!-- Submit Button -->
            <div class="d-grid">
              <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-save"></i> Save Recipe
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('parts/footer') %>
<script>
// Image preview logic
document.getElementById('recipeImage').addEventListener('change', function() {
  const file = this.files[0];
  const previewContainer = document.getElementById('imagePreview');
  const previewImage = document.getElementById('previewImage');
  
  if (file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      previewImage.src = e.target.result;
      previewContainer.style.display = 'block';
    }
    reader.readAsDataURL(file);
  } else {
    previewContainer.style.display = 'none';
  }
});

// Instructions logic
document.addEventListener('DOMContentLoaded', () => {
  const addStepBtn = document.getElementById('addStepBtn');
  const instructionsContainer = document.getElementById('instructionsContainer');

  addStepBtn.addEventListener('click', function() {
    const steps = instructionsContainer.querySelectorAll('.instruction-step');
    const newStepIndex = steps.length + 1;

    const newStep = document.createElement('div');
    newStep.className = 'instruction-step mb-3';
    newStep.innerHTML = `
      <div class="input-group">
        <span class="input-group-text">${newStepIndex}</span>
        <textarea 
          class="form-control" 
          name="instructions[]" 
          placeholder="Describe this step..."
          required
        ></textarea>
        <button type="button" class="btn btn-outline-danger remove-step">
          <i class="bi bi-trash"></i>
        </button>
      </div>
    `;

    newStep.querySelector('.remove-step').addEventListener('click', function() {
      newStep.remove();
      updateStepIndices();
    });

    instructionsContainer.appendChild(newStep);
  });

  function updateStepIndices() {
    const steps = instructionsContainer.querySelectorAll('.instruction-step');
    steps.forEach((step, index) => {
      step.querySelector('.input-group-text').textContent = index + 1;
    });
  }
});

// Ingredient add logic
document.addEventListener('DOMContentLoaded', () => {
  const addIngredientBtn = document.getElementById('addIngredientBtn');
  const ingredientsContainer = document.getElementById('ingredientsContainer');
  const ingredientNameInput = document.getElementById('ingredientNameInput');
  const ingredientUnitInput = document.getElementById('ingredientUnitInput');

  // Ensure form is submitted to the correct route
  const recipeForm = document.getElementById('recipeForm');
  recipeForm.setAttribute('action', '/recipes');
  recipeForm.setAttribute('method', 'POST');

  addIngredientBtn.addEventListener('click', function(e) {
    e.preventDefault();
    const name = ingredientNameInput.value.trim();
    const unit = ingredientUnitInput.value.trim();
    if (!name) return;

    // Create a row for the ingredient
    const row = document.createElement('div');
    row.className = 'row g-2 mb-2 ingredient-row';
    row.innerHTML = `
      <div class="col-sm-6">
        <input type="text" class="form-control" name="ingredient-name" value="${name}" readonly>
      </div>
      <div class="col-sm-3">
        <input type="text" class="form-control" name="ingredient-unit" value="${unit}" readonly>
      </div>
      <div class="col-sm-3">
        <button type="button" class="btn btn-outline-danger remove-ingredient w-100">
          <i class="bi bi-trash"></i> Remove
        </button>
      </div>
    `;
    row.querySelector('.remove-ingredient').addEventListener('click', function() {
      row.remove();
    });
    ingredientsContainer.appendChild(row);

    ingredientNameInput.value = '';
    ingredientUnitInput.value = '';
  });

  // ...existing code for instructions and form submission...
});
</script>