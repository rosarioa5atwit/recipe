{
  "name": "recipe-app",
  "version": "1.0.0",
  "description": "Recipe management application with live reload",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "NODE_ENV=development nodemon app.js",
    "dev-win": "set NODE_ENV=development && nodemon app.js",
    "build": "echo 'No build step required'",
    "install-live": "npm install livereload connect-livereload chokidar nodemon --save-dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "express": "latest",
    "ejs": "latest",
    "cookie-parser": "latest",
    "dotenv": "latest"
  },
  "devDependencies": {
    "livereload": "^0.9.3",
    "connect-livereload": "^0.6.1",
    "chokidar": "^3.5.3",
    "nodemon": "^3.0.1"
  }
}